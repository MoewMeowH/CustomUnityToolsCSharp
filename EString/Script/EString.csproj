<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Roslyn Analyzer 및 확장 규칙 필수 플래그 -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>

    <RootNamespace>EString.Script</RootNamespace>
    <AssemblyName>EString</AssemblyName>
    <!-- 분석기 릴리스 추적(AnalyzerReleases.*.md)은 사용하지 않음 -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>

    <!-- 패키징 및 종속성 관리 설정 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity 6.0+ : 생성기는 Microsoft.CodeAnalysis.CSharp 4.3을 써야 한다 (Unity 매뉴얼). 4.0부터 IIncrementalGenerator -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
