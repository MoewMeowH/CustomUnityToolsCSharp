# IDE · 사용자 설정
.idea/
.vs/
*.user
*.suo

# 빌드 중간 산출물
obj/

# 빌드 산출물은 기본 제외
**/bin/**
!**/bin/**/

# 예외: Unity에 복사해 쓰는 Release dll만 커밋
!EString/Script/bin/Release/netstandard2.0/EString.dll
!UnityTestFrameWorkChecker/HB_TestFrameworkHelper/bin/Release/netstandard2.0/HB_TestFrameworkHelper.dll

# Orchestration publish 결과 (배치가 매번 다시 만듦)
Orchestration/Publish_Output/

# 작업 기록 (계획서 · 작업 로그 · 이미지 첨부 준비 등) — 어느 깊이든 docs/는 로컬에만 둠
docs/

# Orchestration 리뷰 임시폴더
review_tmp/
subagent_in/
# 골든 세트 (사내 코드 포함) — 어느 깊이든 무시, 푸시 가드(H2)와 이중으로 막는다
GoldenSet/
# push_guard 개인 값 (훅 H2, 이 PC에만)
.claude/push_guard.local.txt
# Sync-ProjectFiles -All 대상 목록 (이 PC의 경로)
Orchestration/HB_Orchestration/tools/sync-targets.local.txt
