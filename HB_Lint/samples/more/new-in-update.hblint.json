    "updates": { "kind": "methods.named", "from": "monoBehaviour", "names": ["Update", "LateUpdate", "FixedUpdate"] },
    "news": { "kind": "sites.new", "from": "updates" },
    "referenceTypes": { "kind": "filter.targetType", "from": "news", "category": "reference" },
    "report": { "kind": "report", "from": "referenceTypes", "message": "Update 계열에서 참조 형식을 new 하지 마세요 — 매 프레임 GC 할당입니다. 필드에 만들어 두고 다시 쓰세요." }
  }
