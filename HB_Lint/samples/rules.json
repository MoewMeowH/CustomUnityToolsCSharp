{
  "$schema": "../rules.schema.json",
  "rules": [
    {
      "id": "editor-only-code",
      "kind": "RequireDefine",
      "description": "UnityEditor API와 #if UNITY_EDITOR 안에 선언된 코드는 플레이어 빌드에 없다.",
      "define": "UNITY_EDITOR",
      "message": "에디터 전용 코드입니다 — #if UNITY_EDITOR 안에서만 쓰세요. 플레이어 빌드가 깨집니다.",
      "namespaces": ["UnityEditor"],
      "declaredInDefine": true,
      "ignoreAssemblies": ["Assembly-CSharp-Editor*", "*.Editor", "*.Editor.*", "*.Tests", "*.Tests.*"]
    },
    {
      "id": "no-getcomponent-in-update",
      "kind": "BanCallInMethod",
      "description": "매 프레임 GetComponent는 비싸다.",
      "methods": ["Update", "LateUpdate", "FixedUpdate"],
      "members": ["UnityEngine.Component.GetComponent", "UnityEngine.GameObject.GetComponent"],
      "ownerType": "UnityEngine.MonoBehaviour",
      "message": "Update 계열에서 GetComponent를 부르지 마세요 — Awake에서 필드에 캐싱하세요.",
      "requires": ["UnityEngine.CoreModule"]
    },
    {
      "id": "unity-null-operator",
      "kind": "BanNullOperator",
      "description": "파괴된 Unity 오브젝트는 C# null이 아니라서 ?. · ?? · ??= · is null이 통과시킨다.",
      "type": "UnityEngine.Object",
      "message": "Unity 오브젝트는 ?. · ?? · ??= · is null이 파괴된 오브젝트를 null로 보지 않습니다. '== null' 또는 'if (obj)'로 확인하세요.",
      "requires": ["UnityEngine.CoreModule"],
      "severity": "Warning"
    }
  ]
}
