<Project Sdk="Microsoft.NET.Sdk">

  <!-- rules.json → LintRules.g.cs · rules.schema.json 생성기 코어. 원본은 Unity 패키지 Editor/Generator/ 소스이고 여기서는 링크해 컴파일만 한다.
       의존 없는 netstandard2.0 · C# 9 문법이라 Unity 6.3 에디터에서도 같은 소스가 컴파일된다 (파일마다 #nullable enable).
       HBLint.Attributes도 참조하지 않는다 — 어트리뷰트 어셈블리는 RuleCatalog.FromAssembly로 받는다. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>HBLint.Generator</RootNamespace>
    <AssemblyName>HBLint.Generator</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\com.hb.lint\Editor\Generator\**\*.cs" LinkBase="Generator" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HBLint.Generator.Tests" />
  </ItemGroup>

</Project>
