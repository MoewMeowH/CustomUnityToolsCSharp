@page "{id}"
@model CallModel
@{
    var c = Model.Call;
    ViewData["Title"] = $"{c.Tool} · {c.Timestamp.LocalDateTime:MM-dd HH:mm}";
}

<style>
    .back { display: inline-block; margin-bottom: 12px; }
    .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1px;
            background: var(--line); border-radius: 10px; overflow: hidden; margin-bottom: 16px; border: 1px solid var(--line); }
    .meta div { background: var(--panel); padding: 10px 14px; }
    .meta .label { color: var(--muted); font-size: 12px; }
    .meta .value { font-weight: 600; font-variant-numeric: tabular-nums; word-break: break-all; }
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @@media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
    .card { padding: 16px; min-width: 0; }
    .card h2 { font-size: 13px; color: var(--muted); font-weight: 600; margin: 0 0 10px; }
    .files { padding: 12px 16px; margin-bottom: 16px; }
    .files ul, .files ol { margin: 6px 0 0; padding-left: 18px; }
    .md { overflow-wrap: anywhere; }
    .md pre { margin: 8px 0; }
    .md code { font-family: var(--mono); font-size: 12.5px; background: var(--code); padding: 1px 4px; border-radius: 4px; }
    .md pre code { padding: 0; background: none; }
    .md table { margin: 8px 0; } .md th, .md td { padding: 6px 8px; }
    .side { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) minmax(0, 1.4fr); gap: 16px; margin-bottom: 16px; }
    @@media (max-width: 1100px) { .side { grid-template-columns: 1fr; } }
    .side .card { max-height: 70vh; overflow: auto; }
    .none { color: var(--muted); font-style: italic; }
    .prov td { font-size: 13px; }
    .sha { font-family: var(--mono); font-size: 12px; }
    .view { font-size: 12px; margin-left: 8px; }
    .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; margin-top: 8px; }
    .thumbs figure { margin: 0; }
    .thumbs .box { display: flex; align-items: center; justify-content: center; height: 150px; background: var(--code);
                   border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
    .thumbs img { max-width: 100%; max-height: 150px; }
    .thumbs figcaption { font-size: 12px; margin-top: 4px; word-break: break-all; }
</style>

<a class="back" href="/">← 목록</a>

<section class="meta">
    <div><div class="label">모드</div><div class="value">@c.Tool</div></div>
    <div><div class="label">역할</div><div class="value">@(c.Step is { } st ? $"{st}. " : "")@(c.Role ?? "-")</div></div>
    <div><div class="label">에이전트</div><div class="value">@(c.Agent ?? c.Tool)</div></div>
    <div><div class="label">제공사 / 모델</div><div class="value mono">@IndexModel.ProviderOf(c) / @c.Model</div></div>
    <div><div class="label">시간</div><div class="value">@c.Timestamp.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</div></div>
    <div><div class="label">응답 시간</div><div class="value">@((c.ElapsedMs / 1000.0).ToString("0.0"))s</div></div>
    <div><div class="label">입력 / 출력 토큰</div><div class="value">@(c.InputTokens?.ToString("N0") ?? "-") / @(c.OutputTokens?.ToString("N0") ?? "-")@(c.InputTokens is null ? "" : c.CachedInputTokens is { } cached ? $" (캐시 {cached:N0})" : " (캐시 정보 없음)")</div></div>
    <div><div class="label">예상 비용</div><div class="value">@Model.Pricing.Format(Model.Cost)</div></div>
    <div><div class="label">상태</div><div class="value @(c.Success ? "ok" : "err")">@(c.Success ? "성공" : "실패")@(c.ErrorKind is { } kind ? $" ({kind})" : "")</div></div>
    @if (Model.StepAttempts > 1)
    {
        <div><div class="label">시도</div><div class="value"><span class="badge warn">@(c.Attempt ?? 1) / @Model.StepAttempts</span></div></div>
    }
    <div><div class="label">프로젝트</div><div class="value mono" title="@c.ProjectDir">@IndexModel.ProjectName(c.ProjectDir)</div></div>
    <div>
        <div class="label">Claude 세션</div>
        <div class="value">
            @if (Model.Session is { } ses)
            {
                <a class="mono" href="/ClaudeSession?id=@ses.SessionId">@ClaudeSessionsModel.Short(ses.SessionId)</a>
                <span class="badge @(ses.Kind == HB.Orchestration.Shared.RunLinkKind.Estimated ? "warn" : null)">@(ses.Kind == HB.Orchestration.Shared.RunLinkKind.Confirmed ? "확정" : "추정")</span>
            }
            else
            {
                <span class="muted">연결된 세션 없음</span>
            }
        </div>
    </div>
</section>

<div class="side">
    <section class="panel card">
        <h2>지휘자 — 부른 이유 (reason)</h2>
        @if (Model.IsLegacy) { <p class="none">기록 없음 (5장 이전 기록)</p> }
        else if (string.IsNullOrEmpty(c.Reason)) { <p class="none">기록 없음</p> }
        else { <pre>@c.Reason</pre> }
    </section>
    <section class="panel card">
        <h2>지휘자 — 결과를 보기 전 자체 검토 (ownReview)</h2>
        @if (Model.IsLegacy) { <p class="none">기록 없음 (5장 이전 기록)</p> }
        else if (string.IsNullOrEmpty(c.OwnReview)) { <p class="none">넣지 않음 (이 모드는 필수가 아님)</p> }
        else { <div class="md">@Html.Raw(Model.OwnReviewHtml)</div> }
    </section>
    <section class="panel card">
        <h2>에이전트 응답 (@(c.Agent ?? c.Tool))</h2>
        @if (c.Success)
        {
            <div class="md">@Html.Raw(Model.ResponseHtml)</div>
        }
        else
        {
            <pre class="err">@c.Error</pre>
        }
    </section>
</div>

<section class="panel files">
    <span class="muted" style="font-size:12.5px">에이전트가 받은 지침·설정 — SHA-256 (원문이 저장돼 있으면 열 수 있음)</span>
    @if (c.Provenance is null)
    {
        <p class="none" style="margin:8px 0 0">기록 없음 (5장 이전 기록)</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="prov">
                <thead><tr><th>항목</th><th>경로</th><th>SHA-256</th><th class="num">크기(B)</th><th>비고</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model.ProvenanceRows)
                {
                    <tr>
                        <td>@r.Label</td>
                        <td class="mono" style="word-break:break-all">@(r.Path ?? "")</td>
                        <td class="sha" title="@r.Sha256">@(r.Sha256 is { Length: >= 12 } s12 ? s12[..12] + "…" : "-")</td>
                        <td class="num">@(r.Bytes?.ToString("N0") ?? "-")</td>
                        <td class="muted">@(r.Note ?? "")</td>
                        <td>
                            @if (r.BlobAvailable)
                            {
                                <a href="/Call/@c.Id?handler=Blob&sha=@r.Sha256" target="_blank" rel="noopener">원문</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (c.Provenance.StoreErrors is { Count: > 0 } errors)
        {
            <span class="badge warn">원문 저장 오류</span>
            <ul>@foreach (var e in errors) { <li class="mono">@e</li> }</ul>
        }
    }
</section>

@if (c.Warnings.Count > 0)
{
    <section class="panel files">
        <span class="badge warn">응답 검사기 경고</span>
        <span class="muted" style="font-size:12.5px"> — 응답은 그대로 전달됐습니다</span>
        <ul>
            @foreach (var w in c.Warnings) { <li>@w</li> }
        </ul>
    </section>
}

@if (Model.RunSteps.Count > 1)
{
    var runIn = Model.RunSteps.Sum(r => r.InputTokens ?? 0);
    var runOut = Model.RunSteps.Sum(r => r.OutputTokens ?? 0);
    var runCost = Model.Pricing.TotalOf(Model.RunSteps);
    <section class="panel files">
        <span class="muted" style="font-size:12.5px">
            이 실행의 단계 — 합계 입력 @runIn.ToString("N0") / 출력 @runOut.ToString("N0") 토큰@(runCost is not null ? " · " + Model.Pricing.Format(runCost) : "")
        </span>
        <ol class="steps">
            @foreach (var s in Model.RunSteps)
            {
                <li>
                    @{ var label = $"{s.Role} · {s.Agent}" + (s.Attempt is > 1 ? $" (시도 {s.Attempt})" : ""); }
                    @if (s.Id == c.Id) { <strong>@label</strong> }
                    else { <a href="/Call/@s.Id">@label</a> }
                    <span class="muted"> — @(s.InputTokens?.ToString("N0") ?? "-") / @(s.OutputTokens?.ToString("N0") ?? "-") 토큰, @((s.ElapsedMs / 1000.0).ToString("0.0"))s</span>
                    @if (!s.Success) { <span class="err"> 실패@(s.ErrorKind is { } sk ? $" {sk}" : "")</span> }
                    @if (s.Warnings.Count > 0) { <span class="badge warn" title="@string.Join("\n", s.Warnings)">경고 @s.Warnings.Count</span> }
                    @if (s.Provenance?.InstructionsSha256 is { } ish) { <span class="sha muted" title="시스템 프롬프트 SHA-256 @ish"> · 지침 @ish[..8]</span> }
                </li>
            }
        </ol>
    </section>
}

@if (Model.ContextLinks.Count > 0)
{
    <section class="panel files">
        <span class="muted" style="font-size:12.5px">첨부 코드 — 서버가 읽어 에이전트에게 보낸 범위 (내용은 아래 요청에 있음)</span>
        <ul>
            @for (var i = 0; i < Model.ContextLinks.Count; i++)
            {
                var l = Model.ContextLinks[i];
                <li>
                    <a class="mono" href="/Attachment?id=@c.Id&kind=context&i=@i" title="@l.FullPath">@l.Display</a>
                    @if (l.Url is { } url) { <a class="view" href="@url">Rider</a> }
                    else { <span class="view muted" title="Rider는 열린 솔루션 폴더 안 파일만 연다">Rider 없음</span> }
                    @if (!l.Exists) { <span class="muted"> (이 PC에서 찾을 수 없음)</span> }
                </li>
            }
        </ul>
    </section>
}

@if (Model.Images.Count > 0)
{
    <section class="panel files">
        <span class="muted" style="font-size:12.5px">첨부 이미지 — 서버가 읽어 에이전트에게 보낸 순서. 원문은 기록에 없고 지금 파일을 보여 준다 (기록의 sha256과 비교)</span>
        <div class="thumbs">
            @foreach (var img in Model.Images)
            {
                var view = $"/Attachment?id={c.Id}&kind=images&i={img.Index}";
                <figure>
                    <a href="@view" class="box">
                        @if (img.Match is ImageMatch.Same or ImageMatch.Changed)
                        {
                            <img src="/Attachment?handler=Raw&id=@c.Id&kind=images&i=@img.Index" alt="@img.Path" loading="lazy" />
                        }
                        else
                        {
                            <span class="muted">@Attachments.Describe(img.Match)</span>
                        }
                    </a>
                    <figcaption>
                        <b>@(img.Index + 1).</b> <span class="mono">@img.Path</span><br />
                        <span class="muted">@img.Detail</span><br />
                        <span class="@(img.Match == ImageMatch.Same ? "ok" : "err")">@Attachments.Describe(img.Match)</span>
                    </figcaption>
                </figure>
            }
        </div>
    </section>
}

@if (Model.Links.Count > 0)
{
    <section class="panel files">
        <span class="muted" style="font-size:12.5px">관련 파일 — 클릭하면 대시보드에서 보기, "Rider"는 IDE에서 열기 (솔루션 폴더 안 파일만)</span>
        <ul>
            @for (var i = 0; i < Model.Links.Count; i++)
            {
                var l = Model.Links[i];
                <li>
                    <a class="mono" href="/Attachment?id=@c.Id&kind=files&i=@i" title="@l.FullPath">@l.Display</a>
                    @if (l.Url is { } url) { <a class="view" href="@url">Rider</a> }
                    else { <span class="view muted" title="Rider는 열린 솔루션 폴더 안 파일만 연다">Rider 없음</span> }
                    @if (!l.Exists) { <span class="muted"> (이 PC에서 찾을 수 없음)</span> }
                </li>
            }
        </ul>
    </section>
}

<section class="panel card">
    <h2>요청 (Claude → 에이전트) — 에이전트가 받은 입력 그대로</h2>
    <pre>@c.Prompt</pre>
</section>
