@page
@using HB.Orchestration.Shared
@model VerdictsModel
@{
    ViewData["Title"] = "HB Orchestration · 판정";
    var s = Model.Summary;
}

<style>
    .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
    .toolbar select { font: inherit; padding: 5px 10px; border-radius: 6px; border: 1px solid var(--line); background: var(--panel); color: var(--text); }
    .block { padding: 14px 16px; margin-bottom: 14px; }
    .block h2 { font-size: 14px; margin: 0 0 8px; }
    .note { font-size: 12.5px; margin: 0 0 10px; }
    .v-adopted { color: var(--ok); } .v-partial { color: var(--accent); } .v-rejected { color: var(--err); }
    .v-deferred, .v-duplicate { color: var(--muted); }
    .empty { padding: 40px; text-align: center; }
</style>

<form method="get" class="toolbar">
    <select name="Days" onchange="this.form.submit()">
        @foreach (var (v, label) in new[] { (7, "최근 7일"), (30, "최근 30일"), (90, "최근 90일"), (0, "전체") })
        {
            <option value="@v" selected="@(Model.Days == v)">@label</option>
        }
    </select>
    <span class="muted">판정한 실행 @s.JudgedRuns · 판정 없는 실행 <span class="@(s.Unjudged.Count > 0 ? "err" : null)">@s.Unjudged.Count</span></span>
    <span class="muted mono" style="margin-left:auto">@Model.VerdictPath</span>
</form>

<p class="muted note">
    채택률 = (채택 + 부분 채택 × 0.5) / (채택 + 부분 채택 + 기각). 보류·중복은 빼고 센다.
    판정은 지휘자(Claude)가 내리므로 정확도가 아니라 <strong>지휘자가 받아들인 비율</strong>이다.
    기간은 실행 시작 시각 기준 (소급 판정 포함).
</p>

@if (s.ByAgent.Count == 0 && s.ClaudeOnlyByMode.Count == 0)
{
    <section class="panel empty"><span class="muted">이 기간에 판정이 없습니다. 결과 종합 뒤 <span class="mono">record_verdicts</span>로 남기면 여기에 모입니다.</span></section>
}
else
{
    <section class="panel block">
        <h2>에이전트별</h2>
        <p class="muted note">에이전트만 = ownReview에 없던 채택·부분 채택. 놓침 = Claude만 지적해 채택된 것이 있던 실행에 이 에이전트가 있었던 수 (판정자·검증 역할도 포함). 비용은 판정이 있는 실행의 호출(재시도 포함)만.</p>
        @await Html.PartialAsync("_VerdictTable", s.ByAgent)
    </section>

    <section class="panel block">
        <h2>모드 · 역할별</h2>
        @await Html.PartialAsync("_VerdictTable", s.ByModeRole)
    </section>

    @if (s.ClaudeOnlyByMode.Count > 0)
    {
        <section class="panel block">
            <h2>Claude만 지적 (에이전트가 놓친 것)</h2>
            <div class="table-scroll">
                <table>
                    <thead><tr><th>모드</th><th class="num">지적</th><th class="num">채택</th><th class="num">부분</th><th class="num">기각</th><th class="num">보류</th><th class="num">중복</th></tr></thead>
                    <tbody>
                    @foreach (var r in s.ClaudeOnlyByMode)
                    {
                        <tr><td class="mono">@r.Key</td><td class="num">@r.Findings</td><td class="num">@r.Adopted</td><td class="num">@r.Partial</td><td class="num">@r.Rejected</td><td class="num">@r.Deferred</td><td class="num">@r.Duplicate</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="panel block">
        <h2>최근 판정</h2>
        <div class="table-scroll">
            <table>
                <thead><tr><th>판정</th><th>모드</th><th>지적</th><th>낸 단계</th><th>근거</th></tr></thead>
                <tbody>
                @foreach (var v in s.Recent)
                {
                    var r = v.Verdict;
                    <tr>
                        <td class="v-@r.Verdict" style="white-space:nowrap">@Verdicts.Label(r.Verdict)@(r.Severity is { } sev ? $" · {sev}" : "")</td>
                        <td class="mono">@if (v.FirstCallId is { } id) { <a href="/Call/@id">@v.Mode</a> } else { @v.Mode }</td>
                        <td>@r.Summary@if (r.File is { } f) { <div class="muted mono">@f</div> }</td>
                        <td>@(r.IsClaudeOnly ? "Claude만" : string.Join(", ", v.Agents))@if (!r.IsClaudeOnly && r.ClaudeAlsoFound) { <span class="muted"> (+Claude)</span> }</td>
                        <td class="muted">@r.Reason</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@if (s.Unjudged.Count > 0)
{
    <section class="panel block">
        <h2>판정 없는 실행</h2>
        <ul>
            @foreach (var u in s.Unjudged.Take(30))
            {
                <li><a href="/Call/@u.FirstCallId">@u.Start.LocalDateTime.ToString("MM-dd HH:mm")</a> <span class="mono">@u.Mode</span> <span class="muted mono">@u.RunId</span></li>
            }
        </ul>
        @if (s.Unjudged.Count > 30) { <p class="muted note">외 @(s.Unjudged.Count - 30)건</p> }
    </section>
}
