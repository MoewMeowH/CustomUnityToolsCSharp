@page
@model ModesModel
@using HB.Orchestration.Agents
@{
    ViewData["Title"] = "HB Orchestration · 모드";
    var snap = Model.Snapshot;
}

<style>
    .notice { padding: 10px 14px; border-radius: 8px; margin-bottom: 12px; border: 1px solid var(--line); background: var(--panel); }
    .notice.ok { border-color: var(--ok); }
    .notice.err { border-color: var(--err); }
    .notice.warn { border-color: #d9a400; }
    .notice ul { margin: 4px 0 0; padding-left: 18px; }
    .filebar { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin-bottom: 16px; }
    .filebar .grow { flex: 1; min-width: 0; overflow-wrap: anywhere; }
    .btn { font: inherit; padding: 6px 14px; border-radius: 6px; border: 1px solid var(--line);
           background: var(--panel); color: var(--text); text-decoration: none; cursor: pointer; }
    .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    h2.section { font-size: 14px; color: var(--muted); font-weight: 600; margin: 24px 0 8px; }
    .agents td { white-space: nowrap; }
    .mode { padding: 14px 16px; margin-bottom: 12px; }
    .mode-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; margin-bottom: 12px; }
    .mode-head .name { font-weight: 650; font-size: 15px; }
    .pipe { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .node { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; background: var(--bg); min-width: 150px; }
    .node .role { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
    .node .meta { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
    .node select { width: 100%; font: inherit; font-size: 12.5px; padding: 3px 4px; border-radius: 5px;
                   border: 1px solid var(--line); background: var(--panel); color: var(--text); }
    .node.claude { min-width: 0; background: var(--code); text-align: center; font-weight: 600; font-size: 13px; }
    .node.claude small { display: block; font-weight: 400; color: var(--muted); font-size: 11.5px; }
    .arrow { color: var(--muted); font-size: 18px; }
    .stack { display: flex; flex-direction: column; gap: 6px; padding: 6px; border: 1px dashed var(--line); border-radius: 10px; }
    .stack-label, .loop-label { font-size: 11.5px; color: var(--muted); text-align: center; }
    .loop { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px; border: 1px dashed var(--line); border-radius: 10px; }
    .settings { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; font-size: 12.5px; color: var(--muted); }
    .settings input, .settings select { font: inherit; width: 90px; padding: 3px 6px; border-radius: 5px;
                                        border: 1px solid var(--line); background: var(--panel); color: var(--text); }
    .agents.edit input, .agents.edit select { font: inherit; font-size: 12.5px; padding: 3px 6px; border-radius: 5px;
        border: 1px solid var(--line); background: var(--panel); color: var(--text); width: 140px; }
    .agents.edit input.wide { width: 200px; }
    .agents.edit input[type=number] { width: 90px; }
    .agents.edit input.price { width: 72px; text-align: right; }
    .agents.edit th.price { text-align: right; }
    .rate { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 10px; font-size: 12.5px; color: var(--muted); }
    .rate input { font: inherit; width: 90px; padding: 3px 6px; border-radius: 5px; border: 1px solid var(--line); background: var(--panel); color: var(--text); text-align: right; }
    .agents.edit input[type=checkbox] { width: auto; }
    .agents.edit tr.newrow td { background: var(--code); }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 10px 0 4px; }
    .replace { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
    .replace select { font: inherit; padding: 3px 6px; border-radius: 5px; border: 1px solid var(--line); background: var(--panel); color: var(--text); }
    .savebar { position: sticky; bottom: 0; padding: 12px 0; background: var(--bg); display: flex; gap: 10px; align-items: center; }
</style>

@if (Model.Saved is not null && Model.Errors.Count == 0)
{
    <div class="notice ok">
        @Model.SavedMessage
        @if (Model.Note is not null) { <div class="muted" style="margin-top:4px">@Model.Note</div> }
    </div>
}
@if (Model.LoadError is not null)
{
    <div class="notice err">@Model.LoadError</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="notice err">저장하지 않았습니다.<ul>@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}
@if (Model.Warnings.Count > 0)
{
    <div class="notice warn">확인 필요<ul>@foreach (var w in Model.Warnings) { <li>@w</li> }</ul></div>
}

@if (snap is not null)
{
    <div class="filebar">
        <span class="grow muted mono" title="편집 중인 파일">@snap.ModesPath</span>
        <span class="muted">수정 @snap.LastWriteLocal.ToString("MM-dd HH:mm:ss")</span>
        <a class="btn" href="/Modes">다시 불러오기</a>
    </div>

    if (snap.HasComments || snap.SettingsHasComments)
    {
        <div class="notice warn">설정 파일에 주석(<span class="mono">//</span>)이 있습니다. 여기서 저장하면 그 파일의 주석은 사라집니다. 설명은 README에 정리돼 있습니다.</div>
    }
    <div class="notice muted">
        저장하면 MCP 서버가 다음 호출 때 스스로 다시 읽습니다 — 재시작 불필요. 단, API 키 환경 변수를 바꿨을 때만 PC를 재시작하세요.
        Unity 프로젝트 루트에 <span class="mono">hb-modes.json</span>이 있으면 그 프로젝트에서는 그쪽이 우선하며, 이 화면은 위 경로의 파일만 고칩니다.
    </div>

    var missing = snap.Agents.Count > 0 ? snap.MissingAgents.ToList() : new List<string>();
    if (missing.Count > 0)
    {
        <div class="notice warn">
            appsettings.json에 없는 에이전트를 쓰는 모드가 있습니다. 바꿀 에이전트를 골라 일괄 교체하세요.
            @foreach (var m in missing)
            {
                <form method="post" asp-page-handler="Replace" class="replace">
                    <input type="hidden" name="stamp" value="@snap.Stamp" />
                    <input type="hidden" name="from" value="@m" />
                    <span class="mono">@m</span>
                    <span class="arrow">→</span>
                    <select name="to">
                        @foreach (var a in snap.Agents)
                        {
                            <option value="@a.Name">@a.Name · @a.Model</option>
                        }
                    </select>
                    <button type="submit" class="btn">일괄 교체</button>
                    <span class="muted">사용 중: @(string.Join(", ", Model.UsedBy(m)))</span>
                </form>
            }
        </div>
    }

    <h2 class="section">에이전트 (appsettings.json)</h2>
    if (snap.McpSettingsPath is null)
    {
        <div class="notice err">MCP appsettings.json을 찾지 못했습니다. 대시보드의 Dashboard:McpConfigDir 또는 배치 설정의 PUBLISH_DIR를 확인하세요.</div>
    }
    else
    {
        <form method="post" asp-page-handler="Agents">
            <input type="hidden" name="stamp" value="@snap.Stamp" />
            <input type="hidden" name="settingsStamp" value="@snap.SettingsStamp" />
            <input type="hidden" name="rowCount" value="@(snap.Agents.Count + 1)" />
            <div class="rate">
                <span>환율 1$ =</span>
                <input name="krwPerUsd" inputmode="decimal" value="@PricingService.Number(snap.Pricing.KrwPerUsd)" placeholder="비우면 $만" />
                <span>원 · 단가는 모두 USD / 1M 토큰 · 대시보드 비용은 $와 ₩를 함께 표시</span>
            </div>
            <section class="panel">
                <div class="table-scroll">
                    <table class="agents edit">
                        <thead>
                        <tr><th>이름</th><th>제공사</th><th>모델 ID</th><th>출력 상한</th><th class="price">입력 $</th><th class="price">캐시 입력 $</th><th class="price">출력 $</th><th>사용</th><th>삭제</th><th>쓰는 모드</th></tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i <= snap.Agents.Count; i++)
                        {
                            var a = i < snap.Agents.Count ? snap.Agents[i] : null;
                            var used = a is null ? new List<string>() : Model.UsedBy(a.Name).ToList();
                            var price = Model.PriceOf(a?.Model);
                            <tr class="@(a is null ? "newrow" : null)">
                                <td>
                                    <input type="hidden" name="@("ag.orig." + i)" value="@(a?.Name)" />
                                    <input class="mono" name="@("ag.name." + i)" value="@(a?.Name)" placeholder="@(a is null ? "새 에이전트 이름" : null)" />
                                </td>
                                <td>
                                    <select name="@("ag.provider." + i)">
                                        @foreach (var p in snap.ProviderNames)
                                        {
                                            <option value="@p" selected="@(a is not null && string.Equals(a.Provider, p, StringComparison.OrdinalIgnoreCase))">@p</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="mono wide" name="@("ag.model." + i)" value="@(a?.Model)" placeholder="모델 ID" /></td>
                                <td><input type="number" min="1" name="@("ag.max." + i)" value="@(a?.MaxOutputTokens)" placeholder="없음" /></td>
                                <td><input class="price mono" inputmode="decimal" name="@("ag.pin." + i)" value="@PricingService.Number(price?.InputPerMillion)" placeholder="-" /></td>
                                <td><input class="price mono" inputmode="decimal" name="@("ag.pcache." + i)" value="@PricingService.Number(price?.CachedInputPerMillion)" placeholder="=입력" /></td>
                                <td><input class="price mono" inputmode="decimal" name="@("ag.pout." + i)" value="@PricingService.Number(price?.OutputPerMillion)" placeholder="-" /></td>
                                <td><input type="checkbox" name="@("ag.enabled." + i)" value="true" checked="@(a?.Enabled ?? true)" /></td>
                                <td>
                                    @if (a is not null)
                                    {
                                        <input type="checkbox" name="@("ag.del." + i)" value="true" disabled="@(used.Count > 0)"
                                               title="@(used.Count > 0 ? "모드에서 쓰는 중이라 삭제할 수 없습니다" : "삭제")" />
                                    }
                                </td>
                                <td class="muted">@(used.Count > 0 ? string.Join(", ", used) : "-")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
            <div class="actions">
                <button type="submit" class="btn primary">에이전트 저장</button>
                <span class="muted">마지막 빈 줄 = 새 에이전트 · 이름을 바꾸면 그 이름을 쓰는 모드도 같이 바뀝니다 · 단가는 모델 단위(같은 모델을 쓰는 줄은 같은 값), 셋 다 비우면 삭제 · 백업: <span class="mono">settings-backup/</span></span>
            </div>
        </form>
    }

    <h2 class="section">모드</h2>
    <form method="post">
        <input type="hidden" name="stamp" value="@snap.Stamp" />

        @foreach (var (name, mode) in snap.Typed.Modes)
        {
            var steps = mode.Steps;
            var returnRaw = Model.Raw(name, "Return");
            var returnLabel = mode.Flow == ModeFlow.Concurrent || mode.Return == ModeReturn.All ? "모든 결과" : "마지막 결과만";

            <section class="panel mode">
                <div class="mode-head">
                    <span class="name mono">@name</span>
                    <span class="badge">@ModesModel.FlowLabel(mode.Flow)</span>
                    <span class="muted">@mode.Description</span>
                </div>

                <div class="pipe">
                    <div class="node claude">Claude<small>요청</small></div>
                    <span class="arrow">→</span>

                    @if (mode.Flow == ModeFlow.Concurrent)
                    {
                        <div class="stack">
                            <div class="stack-label">동시 실행 · 서로 결과를 보지 않음</div>
                            @for (var i = 0; i < steps.Count; i++) { await RenderNode(name, i, steps[i], showSees: false); }
                        </div>
                    }
                    else if (mode.Flow == ModeFlow.Debate && steps.Count >= 2)
                    {
                        <div class="loop">
                            @{ await RenderNode(name, 0, steps[0], showSees: false); }
                            <span class="arrow">⇄</span>
                            @{ await RenderNode(name, 1, steps[1], showSees: false); }
                            <div class="loop-label" style="width:100%">
                                최대 @(Math.Clamp(mode.MaxRounds ?? 2, 1, ModeDefinition.MaxRoundsHardCap))회차 · 직전 발언 @(mode.HistoryWindow)개만 봄 · [합의] 시 조기 종료
                            </div>
                        </div>
                        if (steps.Count >= 3)
                        {
                            <span class="arrow">→</span>
                            await RenderNode(name, 2, steps[2], showSees: false);
                        }
                    }
                    else
                    {
                        for (var i = 0; i < steps.Count; i++)
                        {
                            if (i > 0) { <span class="arrow">→</span> }
                            await RenderNode(name, i, steps[i], showSees: i > 0);
                        }
                    }

                    <span class="arrow">→</span>
                    <div class="node claude">Claude<small>@returnLabel</small></div>
                </div>

                <div class="settings">
                    <label>세션당 실행 한도
                        <input type="number" min="0" name="@ModesModel.SettingField(name, "MaxRunsPerSession")"
                               value="@Model.Raw(name, "MaxRunsPerSession")" placeholder="기본값" />
                    </label>
                    @if (mode.Flow == ModeFlow.Debate)
                    {
                        <label>최대 회차
                            <input type="number" min="1" max="@ModeDefinition.MaxRoundsHardCap" name="@ModesModel.SettingField(name, "MaxRounds")"
                                   value="@Model.Raw(name, "MaxRounds")" placeholder="2" />
                        </label>
                    }
                    @if (mode.Flow != ModeFlow.Concurrent)
                    {
                        <label>Claude에게 반환
                            <select name="@ModesModel.SettingField(name, "Return")">
                                <option value="" selected="@(returnRaw is null)">기본 (마지막만)</option>
                                <option value="Last" selected="@(returnRaw == "Last")">마지막만</option>
                                <option value="All" selected="@(returnRaw == "All")">모든 단계</option>
                            </select>
                        </label>
                    }
                </div>
            </section>
        }

        <div class="savebar">
            <button type="submit" class="btn primary">저장</button>
            <span class="muted">저장 전 자동 백업: <span class="mono">modes-backup/</span> (최근 10개)</span>
        </div>
    </form>
}

@functions {
    // 단계 하나를 그린다: 역할 + 에이전트 선택.
    // <option>이 태그 헬퍼로 처리되므로 이 메서드는 async Task여야 한다 (MVC1006).
    async Task RenderNode(string mode, int index, StepDefinition step, bool showSees)
    {
        var current = Model.FindAgent(step.Agent);
        <div class="node">
            <div class="role">@step.Role</div>
            <select name="@ModesModel.AgentField(mode, index)">
                @if (current is null)
                {
                    <option value="@step.Agent" selected>@step.Agent (appsettings에 없음)</option>
                }
                @foreach (var a in Model.Snapshot!.Agents)
                {
                    var isCurrent = string.Equals(a.Name, step.Agent, StringComparison.OrdinalIgnoreCase);
                    <option value="@a.Name" selected="@isCurrent" disabled="@(!a.Enabled && !isCurrent)">
                        @a.Name · @(a.Model + (a.Enabled ? "" : " (꺼짐)"))
                    </option>
                }
            </select>
            @if (showSees)
            {
                <div class="meta">보는 내용: @ModesModel.SeesLabel(step.Sees)</div>
            }
        </div>
    }
}
