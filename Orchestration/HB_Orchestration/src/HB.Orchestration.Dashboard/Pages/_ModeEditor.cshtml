@model ModesModel
@*
    모드 절: 그래프 편집기 (AntV X6). 화면은 Lib/mode-graph.js가 아래 JSON 자료로 그리고,
    저장은 숨은 폼으로 모드 · 역할을 하나씩 보낸다 (위조 방지 토큰 · 스탬프 · 리다이렉트는 다른 표와 같다).
*@
<style>
    .me { display: grid; grid-template-columns: 176px minmax(0, 1fr) 284px; gap: 12px; align-items: start; }
    .me.me-wide { grid-template-columns: 176px minmax(0, 1fr) 500px; }
    .me h3 { font-size: 13px; margin: 0; }
    .me-side-head { display: flex; align-items: center; justify-content: space-between; font-size: 13px; font-weight: 600; margin: 4px 0 6px; }
    .me-side-head .btn { padding: 2px 10px; font-size: 12px; }
    .me-list { display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; max-height: 420px; overflow-y: auto; }
    .me-item { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; text-align: left; font: inherit; cursor: pointer;
               padding: 5px 9px; border-radius: 7px; border: 1px solid var(--line); background: var(--panel); color: var(--text); }
    .me-item.sel { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
    .me-item-meta { font-size: 11.5px; color: var(--muted); }
    .me-main { padding: 12px 14px; min-width: 0; }
    .me-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; margin-bottom: 10px; }
    .me-name { font-weight: 650; font-size: 15px; }
    .me-graph-box { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); }
    .me-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 10px; }
    .me-spacer { flex: 1; }
    .me-node { box-sizing: border-box; width: 100%; height: 100%; border: 1px solid var(--line); border-radius: 8px; background: var(--panel);
               color: var(--text); padding: 7px 9px; font-size: 12.5px; cursor: pointer; }
    .me-node.sel { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
    .me-node-title { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; font-weight: 600; margin-bottom: 5px; }
    .me-chip { font-weight: 400; font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0 6px; }
    .me-node select { width: 100%; box-sizing: border-box; font: inherit; font-size: 12px; padding: 2px 3px; margin-top: 3px; border-radius: 5px;
                      border: 1px solid var(--line); background: var(--bg); color: var(--text); }
    .me-inspector { padding: 12px 14px; display: flex; flex-direction: column; gap: 10px; }
    .me-field { display: flex; flex-direction: column; gap: 3px; font-size: 12.5px; }
    .me-label { color: var(--muted); }
    .me-hint { font-size: 11.5px; color: var(--muted); }
    .me-warn { font-size: 12px; color: var(--err); }
    .me-field input[type=text], .me-field input[type=number], .me-field select, .me-field textarea {
        font: inherit; padding: 4px 6px; border-radius: 5px; border: 1px solid var(--line); background: var(--bg); color: var(--text);
        width: 100%; box-sizing: border-box; }
    .me-field input[type=checkbox] { align-self: flex-start; }
    .me-field textarea { resize: vertical; }
    .me-prompt { font-family: var(--mono); font-size: 12px; line-height: 1.5; }
    .me-row { display: flex; gap: 8px; align-items: center; }
    .me-row select { flex: 1; min-width: 0; }
    .me-checks { display: flex; flex-direction: column; gap: 2px; }
    .me-step-ops { margin-top: 4px; flex-wrap: wrap; }
    @@media (max-width: 1100px) { .me { grid-template-columns: 1fr; } }
</style>

<h2 class="section">모드</h2>
<div class="notice muted">
    모드 · 역할을 하나씩 저장합니다. 저장 전 자동 백업: <span class="mono">modes-backup/</span> (최근 10개).
    @if (Model.HasModesSource)
    {
        <text>저장하면 git 원본 <span class="mono">modes.json</span>에도 같은 수정을 적용합니다.</text>
    }
    else
    {
        <text>git 원본에는 적용하지 않고 사용 중 사본만 고칩니다 (원본 경로 설정 <span class="mono">Dashboard:ModesSourcePath</span>가 없거나, 편집 중인 파일이 서버 폴더의 기본 <span class="mono">modes.json</span>이 아님).</text>
    }
</div>

<div class="me" id="mode-editor">
    <aside>
        <div class="me-side-head">모드 <button type="button" class="btn" id="me-new-mode">새 모드</button></div>
        <div class="me-list" id="me-mode-list"></div>
        <div class="me-side-head">역할 <button type="button" class="btn" id="me-new-role">새 역할</button></div>
        <div class="me-list" id="me-role-list"></div>
    </aside>
    <section class="panel me-main">
        <div class="me-head" id="me-head"></div>
        <div class="me-graph-box"><div id="me-graph"></div></div>
        <div class="me-actions" id="me-actions"></div>
    </section>
    <aside class="panel me-inspector" id="me-inspector"></aside>
</div>

<form method="post" asp-page-handler="Mode" id="me-form-mode" hidden>
    <input type="hidden" name="stamp" value="@Model.EditorStamp" />
    <input type="hidden" name="originalName" />
    <input type="hidden" name="name" />
    <input type="hidden" name="modeJson" />
</form>
<form method="post" asp-page-handler="DeleteMode" id="me-form-delete-mode" hidden>
    <input type="hidden" name="stamp" value="@Model.EditorStamp" />
    <input type="hidden" name="name" />
</form>
<form method="post" asp-page-handler="Role" id="me-form-role" hidden>
    <input type="hidden" name="stamp" value="@Model.EditorStamp" />
    <input type="hidden" name="name" />
    <input type="hidden" name="roleJson" />
    <input type="hidden" name="isNew" />
    <input type="hidden" name="mode" />
</form>
<form method="post" asp-page-handler="DeleteRole" id="me-form-delete-role" hidden>
    <input type="hidden" name="stamp" value="@Model.EditorStamp" />
    <input type="hidden" name="name" />
    <input type="hidden" name="mode" />
</form>

@* 편집기 자료: 직렬화가 < > & 를 \uXXXX로 바꿔 내므로 script 블록 안에서 그대로 쓴다 *@
<script type="application/json" id="me-data">@Html.Raw(Model.EditorJson)</script>
<script src="/lib/x6.min.js?v=@LibFiles.Version"></script>
<script src="/lib/mode-graph.js?v=@LibFiles.Version"></script>
