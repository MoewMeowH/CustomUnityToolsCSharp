@page
@model IndexModel
@{
    ViewData["Title"] = "HB Orchestration · 호출 기록";
    var maxDaily = Model.Daily.Count == 0 ? 1 : Math.Max(1, Model.Daily.Max(d => d.Tokens));
}
@section Head {
    @if (Model.Live) { <meta http-equiv="refresh" content="10" /> }
}

<style>
    .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 16px; }
    .toolbar select, .toolbar button, .toolbar input[type=search] { font: inherit; padding: 5px 10px; border-radius: 6px;
        border: 1px solid var(--line); background: var(--panel); color: var(--text); }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .stat { padding: 14px 16px; }
    .stat .label { color: var(--muted); font-size: 12.5px; }
    .stat .value { font-size: 22px; font-weight: 650; font-variant-numeric: tabular-nums; margin-top: 2px; }
    .daily { padding: 14px 16px; margin-bottom: 16px; }
    .platforms { padding: 14px 16px; margin-bottom: 16px; }
    .bars { display: flex; align-items: flex-end; gap: 6px; height: 80px; margin-top: 10px; }
    .bar { flex: 1; min-width: 8px; background: var(--accent); opacity: .8; border-radius: 3px 3px 0 0; }
    .bar-labels { display: flex; gap: 6px; margin-top: 4px; }
    .bar-labels span { flex: 1; min-width: 8px; text-align: center; font-size: 11px; color: var(--muted); overflow: hidden; }
    td a.row-link { color: var(--text); text-decoration: none; }
    a.badge.run { text-decoration: none; color: var(--muted); }
    .toolbar input[type=search] { min-width: 220px; }
    .empty { padding: 40px; text-align: center; }
</style>

<form method="get" class="toolbar">
    <select name="Days" onchange="this.form.submit()">
        @foreach (var (v, label) in new[] { (1, "최근 24시간"), (7, "최근 7일"), (30, "최근 30일"), (0, "전체") })
        {
            <option value="@v" selected="@(Model.Days == v)">@label</option>
        }
    </select>
    <select name="Tool" onchange="this.form.submit()">
        <option value="">모든 모드</option>
        @foreach (var t in Model.ToolNames)
        {
            <option value="@t" selected="@(Model.Tool == t)">@t</option>
        }
    </select>
    <select name="Provider" onchange="this.form.submit()">
        <option value="">모든 제공사</option>
        @foreach (var p in Model.ProviderNames)
        {
            <option value="@p" selected="@(Model.Provider == p)">@p</option>
        }
    </select>
    <input type="search" name="Q" value="@Model.Q" placeholder="검색 (run id · 이유 · 모델 · 파일 · 응답…)" />
    @if (!string.IsNullOrWhiteSpace(Model.Run))
    {
        <input type="hidden" name="Run" value="@Model.Run" />
        <span class="badge">실행 <span class="mono">@Model.Run</span> <a href="?Days=@Model.Days" title="실행 필터 해제">×</a></span>
    }
    <label class="muted"><input type="checkbox" name="Live" value="true" checked="@Model.Live" onchange="this.form.submit()" /> 자동 새로고침</label>
    <span class="muted mono" style="margin-left:auto">@Model.Opt.ResolvedLogPath</span>
</form>

@if (Model.SubReviewMonthRuns > 0 || Model.SubReviewQuotaAt is not null)
{
    <p style="margin:-6px 0 12px">
        <a class="badge" href="@Model.SubReviewLink" title="claude-cli 제공사(HB_REVIEWER_API_KEY) 검토 — sub_* 모드. 비용은 MCP 단가 기준">API 리뷰(sub_*) 이번 달 @(Model.SubReviewMonthRuns)회 · $@Model.SubReviewMonthCost.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)@(Model.SubReviewMonthUnpriced > 0 ? $" (단가 없음 {Model.SubReviewMonthUnpriced}건)" : "")</a>
        @if (Model.SubReviewQuotaAt is { } quotaAt)
        {
            var holdHours = HB.Orchestration.Agents.ModeRunner.ClaudeCliQuotaHold.TotalHours;
            if (Model.SubReviewQuotaHoldOver)
            {
                <span class="badge" title="마지막 판정 가능한 API 리뷰 기록이 Quota지만 @(holdHours)시간이 지났다. 다음 호출에서 다시 시도한다">크레딧 소진 기록 (@quotaAt.ToLocalTime().ToString("MM-dd HH:mm")) — 다음 호출에서 다시 시도</span>
            }
            else
            {
                <span class="badge warn" title="마지막 판정 가능한 API 리뷰 기록이 Quota. @(holdHours)시간 동안은 호출하지 않고 서브에이전트로 대체한다">크레딧 소진 (@quotaAt.ToLocalTime().ToString("MM-dd HH:mm")) — 서브에이전트로 대체 중</span>
            }
        }
    </p>
}
@if (Model.UnrecordedSubagents > 0)
{
    <p style="margin:-6px 0 12px"><a class="badge warn" href="/Subagents?Days=7&Unrecorded=true" title="selfReview · ownReview 어디에도 들어가지 않은 검토형 서브에이전트 결과">기록 없는 서브에이전트 결과 @(Model.UnrecordedSubagents)건 (최근 7일)</a></p>
}

<section class="stats">
    <div class="panel stat" title="오늘 0시부터 · MCP 단가로 계산 · 무료 제공사 제외 (위 필터와 무관). 단가 없는 모델은 비용에 들어가지 않는다">
        <div class="label">오늘 비용@(Model.TodayUnpriced > 0 ? $" · 단가 없는 모델 {Model.TodayUnpriced}건(비용 미집계)" : "")@Model.TodayEstimateNote</div>
        <div class="value @(Model.TodayUnpriced > 0 ? "err" : "")">$@Model.TodayCost.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</div>
    </div>
    <div class="panel stat" title="오늘 0시부터 · 입력+출력 · 무료 제공사 제외 (위 필터와 무관)">
        <div class="label">오늘 토큰</div>
        <div class="value">@Model.TodayCounted.ToString("N0")</div>
    </div>
    <div class="panel stat"><div class="label">호출</div><div class="value">@Model.Calls.Count.ToString("N0")</div></div>
    <div class="panel stat"><div class="label" title="캐시 정보 없음 = 제공사가 캐시 값을 주지 않은 기록 (미적중 0과 다름)">입력 토큰 (캐시 @Model.TotalCached.ToString("N0")@(Model.TotalCacheWrite > 0 ? $" · 쓰기 {Model.TotalCacheWrite:N0}" : "")@(Model.CacheUnknown > 0 ? $" · 정보 없음 {Model.CacheUnknown}건" : ""))</div><div class="value">@Model.TotalIn.ToString("N0")</div></div>
    <div class="panel stat"><div class="label">출력 토큰@(Model.TotalReasoning > 0 ? $" (추론 {Model.TotalReasoning:N0})" : "")</div><div class="value">@Model.TotalOut.ToString("N0")</div></div>
    <div class="panel stat"><div class="label">평균 응답</div><div class="value">@Model.AvgSeconds.ToString("0.0")s</div></div>
    <div class="panel stat"><div class="label" title="따로 청구되는 플랫폼만 (구독 · 로컬 제외). 끊긴 호출(Timeout · Network · 취소 · 강제 종료)은 추정 사용량으로 센다">예상 비용@(Model.Pricing.Current.KrwPerUsd is { } rate ? $" · 1$ = ₩{rate:N0}" : "")@Model.Pricing.EstimateNote(Model.PaidCalls, 3)</div><div class="value">@Model.Pricing.Format(Model.TotalCost, 3)</div></div>
    <div class="panel stat"><div class="label">실패</div><div class="value @(Model.Failures > 0 ? "err" : "")">@Model.Failures</div></div>
</section>

@if (Model.Platforms.Count > 0)
{
    <section class="panel platforms">
        <div class="muted" style="font-size:12.5px" title="같은 API 키를 쓰는 제공사는 한 줄. 기록을 단가로 계산한 값이라 콘솔 금액과 다를 수 있다. 모드 · 제공사 · 검색 필터는 따르지 않는다">플랫폼별 비용 (호출 기록 기준)</div>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr><th>플랫폼</th><th class="num">이 기간</th><th class="num">이번 달</th><th class="num">호출</th><th class="num">크레딧</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Platforms)
                    {
                        var unpriced = p.UnpricedCalls > 0 ? $"단가 없는 호출 {p.UnpricedCalls}건은 금액에 없음" : null;
                        <tr>
                            <td>@p.Name @if (p.NoCharge) { <span class="badge" title="구독 · 로컬이라 따로 청구되지 않는다. 합계에 넣지 않는다">청구 없음</span> }</td>
                            @if (p.NoCharge)
                            {
                                <td class="num muted" title="API 단가로 환산한 값 · @Model.Pricing.Format(p.PeriodUsd, 2)">-</td>
                                <td class="num muted" title="API 단가로 환산한 값 · @Model.Pricing.Format(p.MonthUsd, 2)">-</td>
                            }
                            else
                            {
                                <td class="num" title="@unpriced">@Model.Pricing.Format(p.PeriodUsd, 2)</td>
                                <td class="num">@Model.Pricing.Format(p.MonthUsd, 2)</td>
                            }
                            <td class="num">@p.PeriodCalls.ToString("N0")</td>
                            @if (p.Credit is { } credit)
                            {
                                <td class="num @(credit.NearLimit || credit.UnpricedCalls > 0 ? "err" : "")" title="지난 갱신일부터 호출 기록으로 센 값. 실제 잔액은 콘솔이 기준이다">$@credit.UsedUsd.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) / $@credit.LimitUsd.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) (@credit.Percent%) · @credit.Renews.ToString("MM-dd") 갱신@(credit.UnpricedCalls > 0 ? $" · 단가 없음 {credit.UnpricedCalls}건 빠짐" : "")</td>
                            }
                            else
                            {
                                <td class="num muted">-</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.Daily.Count > 1)
{
    <section class="panel daily">
        <div class="muted" style="font-size:12.5px">일별 토큰</div>
        <div class="bars">
            @foreach (var d in Model.Daily)
            {
                <div class="bar" style="height:@((int)(d.Tokens * 100 / maxDaily))%"
                     title="@d.Day.ToString("MM-dd") · @d.Tokens.ToString("N0") 토큰 · @d.Count 회"></div>
            }
        </div>
        <div class="bar-labels">
            @foreach (var d in Model.Daily) { <span>@d.Day.ToString("MM/dd")</span> }
        </div>
    </section>
}

<section class="panel">
    @if (Model.Calls.Count == 0)
    {
        <div class="empty muted">기록이 없습니다. Claude Code에서 에이전트 도구가 호출되면 여기에 쌓입니다.</div>
    }
    else
    {
        <div class="table-scroll">
        <table>
            <thead>
            <tr>
                <th>시간</th><th>모드</th><th>역할 · 에이전트</th><th>제공사 / 모델</th><th>프로젝트</th><th>이유</th>
                <th class="num">입력</th><th class="num">출력</th><th class="num">시간</th><th class="num">비용</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.PageCalls)
            {
                var cost = Model.Pricing.CostOf(c);
                var estimate = PricingService.EstimateLabel(c);
                <tr>
                    <td class="num"><a class="row-link" href="/Call/@c.Id">@c.Timestamp.LocalDateTime.ToString("MM-dd HH:mm:ss")</a></td>
                    <td>
                        <span class="badge">@c.Tool</span>
                        @if (c.RunId is { } run)
                        {
                            <a class="badge run mono" href="?Run=@run&Days=0" title="실행 @run · 눌러서 이 실행만 보기">@run[..Math.Min(6, run.Length)]</a>
                            @if (Model.IsRunHead(c) && Model.VerdictCount(run) is var vc and > 0)
                            {
                                <span class="badge" title="지휘자 판정 @(vc)건 (record_verdicts)">판정 @vc</span>
                            }
                        }
                    </td>
                    <td>
                        @(c.Step is { } st ? $"{st}. " : "")@(c.Role ?? "-") · @(c.Agent ?? c.Tool)
                        @if (Model.AttemptOf(c) is { } at)
                        {
                            <span class="badge warn" title="이 단계는 재시도가 있었습니다@(c.ErrorKind is { } k ? $" · 이 시도 {k}" : "")">시도 @at.Attempt/@at.Total</span>
                        }
                    </td>
                    <td><span class="badge">@IndexModel.ProviderOf(c)</span> <span class="mono">@c.Model</span>@if (c.ReasoningEffort is { } effort) {<span class="muted" title="보낸 추론 강도"> · @effort</span>}</td>
                    <td>@IndexModel.ProjectName(c.ProjectDir)</td>
                    <td>
                        @if (c.Warnings.Count > 0)
                        {
                            <span class="badge warn" title="@string.Join("\n", c.Warnings)">경고 @c.Warnings.Count</span>
                        }
                        <a class="row-link" href="/Call/@c.Id" title="@IndexModel.Preview(c.Success ? c.Response : c.Error, 300)">
                            @if (!c.Success) { <span class="err">@IndexModel.Preview(c.Error)</span> }
                            else if (string.IsNullOrWhiteSpace(c.Reason)) { @IndexModel.Preview(c.Response) }
                            else if (Model.IsRunHead(c)) { @IndexModel.Preview(c.Reason) }
                            else { <span class="muted">↳ 같은 실행</span> }
                        </a>
                        @if (c.Files.Count > 0) { <span class="muted"> · 파일 @c.Files.Count</span> }
                        @if (c.Context.Count > 0) { <span class="muted"> · 첨부 @c.Context.Count</span> }
                        @if (c.Images is { Count: > 0 } imgs) { <span class="muted"> · 이미지 @imgs.Count</span> }
                        @if (c.WebSearch is { } search) { <span class="@(search.Unverified.Count > 0 ? "err" : "muted")"> · 검색 @search.Calls@(search.SearchActions is { } billed && billed != search.Calls ? $" (청구 추정 {billed})" : "")@(search.Unverified.Count > 0 ? $" (출처 의심 {search.Unverified.Count})" : "")</span> }
                    </td>
                    <td class="num" title="@estimate">@(estimate is null ? "" : "≈")@(c.InputTokens?.ToString("N0") ?? "-")</td>
                    <td class="num" title="@estimate">@(estimate is null ? "" : "≈")@(c.Estimate is { OutputUnknown: true } ? "?" : c.OutputTokens?.ToString("N0") ?? "-")</td>
                    <td class="num">@((c.ElapsedMs / 1000.0).ToString("0.0"))s</td>
                    <td class="num" title="@estimate">@(estimate is null ? "" : "≈")@Model.Pricing.Format(cost)</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        @if (Model.PageCount > 1)
        {
            var first = (Model.P - 1) * IndexModel.PageSize + 1;
            <nav class="toolbar muted" style="justify-content:center">
                @if (Model.P > 1) { <a href="@Model.PageUrl(Model.P - 1)">← 이전</a> }
                @for (var p = 1; p <= Model.PageCount; p++)
                {
                    if (p == Model.P) { <strong>@p</strong> }
                    else if (p <= 2 || p > Model.PageCount - 2 || Math.Abs(p - Model.P) <= 2) { <a href="@Model.PageUrl(p)">@p</a> }
                    else if (p == 3 || p == Model.PageCount - 2) { <span>…</span> }
                }
                @if (Model.P < Model.PageCount) { <a href="@Model.PageUrl(Model.P + 1)">다음 →</a> }
                <span>@first.ToString("N0")–@((first + Model.PageCalls.Count - 1).ToString("N0")) / @Model.Calls.Count.ToString("N0")건</span>
            </nav>
        }
    }
</section>
