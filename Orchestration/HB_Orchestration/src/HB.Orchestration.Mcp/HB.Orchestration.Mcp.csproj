<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HB.Orchestration.Agents\HB.Orchestration.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      설정 파일은 publish 때 복사하지 않는다 (publish 폴더에서 직접 고친 설정을 덮어쓰지 않도록).
      publish 폴더에 아직 없을 때만 HB_Orchestration.bat이 처음 한 번 복사해 넣는다.
    -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="modes.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="Prompts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
