{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Orchestration": {
    "ModesPath": "",
    "GuidelinesPath": "",
    "PromptsPath": "",
    "Providers": {
      "openai": {
        "Type": "openai-compatible",
        "PromptCache": "Context",
        "StructuredOutput": "Schema",
        "ApiKeyEnv": "OPENAI_API_KEY",
        "TimeoutSeconds": 600
      },
      "openai-web": {
        "Type": "openai-responses",
        "ApiKeyEnv": "OPENAI_API_KEY",
        "TimeoutSeconds": 600
      },
      "gemini": {
        "Type": "openai-compatible",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ApiKeyEnv": "GEMINI_API_KEY",
        "TimeoutSeconds": 600
      },
      "local": {
        "Type": "openai-compatible",
        "Endpoint": "http://localhost:11434/v1"
      },
      "fireworks": {
        "Type": "openai-compatible",
        "Endpoint": "https://api.fireworks.ai/inference/v1",
        "ApiKeyEnv": "FIREWORKS_API_KEY",
        "TimeoutSeconds": 600
      },
      "anthropic-cli": {
        "Type": "claude-cli",
        "ApiKeyEnv": "HB_REVIEWER_API_KEY",
        "TimeoutSeconds": 900,
        "MaxAttempts": 1
      },
      "codex": {
        "Type": "codex-cli",
        "TimeoutSeconds": 900,
        "MaxAttempts": 1
      }
    },
    "Agents": [
      {
        "Name": "gpt_high_astra",
        "Provider": "openai",
        "Model": "gpt-6-astra",
        "MaxOutputTokens": 16000
      },
      {
        "Name": "gpt_main_sol",
        "Provider": "openai",
        "Model": "gpt-6.1-sol",
        "MaxOutputTokens": 64000,
        "ReasoningEffort": "medium"
      },
      {
        "Name": "gpt_mini_luna",
        "Provider": "openai",
        "Model": "gpt-6-luna",
        "MaxOutputTokens": 18000
      },
      {
        "Name": "gpt_mini_luna_web",
        "Provider": "openai-web",
        "Model": "gpt-6-luna",
        "MaxOutputTokens": 18000
      },
      {
        "Name": "gemini_high_argon",
        "Provider": "gemini",
        "Model": "gemini-4-argon",
        "Note": "ReasoningEffort 비어 있음 = Gemini OpenAI 호환 기본값으로 동작 (추론 거의 없음, 2026-10-21 실측). high 명시는 비용 약 6배·시간 약 10배 (T1). 설정 변경은 사용자 결정, 이름은 provenance와 연결돼 바꾸지 않음.",
        "MaxOutputTokens": 64000,
        "StructuredOutput": "Schema"
      },
      {
        "Name": "gemini_main_flash",
        "Provider": "gemini",
        "Model": "gemini-3.8-flash",
        "MaxOutputTokens": 32000
      },
      {
        "Name": "local",
        "Provider": "local",
        "Model": "<ollama list의 모델>",
        "Enabled": false,
        "Vision": false
      },
      {
        "Name": "gemini_mini_lite",
        "Provider": "gemini",
        "Model": "gemini-3.5-flash-lite",
        "MaxOutputTokens": 10000
      },
      {
        "Name": "deepseek_main_flash",
        "Provider": "fireworks",
        "Model": "accounts/fireworks/models/deepseek-v4p1-flash-1017",
        "MaxOutputTokens": 64000,
        "Vision": false,
        "StructuredOutput": "Schema",
        "Note": "ReasoningEffort 비어 있음 = Fireworks 기본값 (골든 DeepSeek 기준점도 같은 조건으로 측정). 2026-10-22부터 review_high · perf_high의 두 번째 리뷰어. Vision false는 우리 이미지 경로로 확인 전이라 끈 것 (Fireworks 모델 페이지는 이미지 입력 지원으로 표시)."
      },
      {
        "Name": "claude_cli_opus",
        "Provider": "anthropic-cli",
        "Model": "claude-opus-5-5",
        "ReasoningEffort": "high",
        "MaxTurns": 40,
        "MaxBudgetUsd": 2,
        "MaxAttempts": 1,
        "Vision": false,
        "Note": "claude --bare -p 읽기 전용 검토 (sub_self). 키는 HB_REVIEWER_API_KEY — ANTHROPIC_API_KEY로 두면 Claude Code 자체가 API 과금으로 바뀐다. 재시도 1회 = 리뷰 1회 비용이 그대로 늘어서 끔."
      },
      {
        "Name": "codex_cli_sol",
        "Provider": "codex",
        "Model": "gpt-6.1-sol",
        "ReasoningEffort": "medium",
        "MaxAttempts": 1,
        "Vision": false,
        "StructuredOutput": "Schema",
        "Note": "codex exec 읽기 전용 리뷰 (review_main). ChatGPT 구독 로그인 — 비용 대신 구독 한도(5시간 · 주간)를 쓴다. 한도 소진이면 review_main이 gpt_main_sol(API)로 대신한다."
      }
    ],
    "Budget": {
      "MaxInputChars": 350000,
      "FreeProviders": [
        "local",
        "codex"
      ]
    },
    "Images": {
      "MaxCount": 20,
      "MaxBytes": 2000000,
