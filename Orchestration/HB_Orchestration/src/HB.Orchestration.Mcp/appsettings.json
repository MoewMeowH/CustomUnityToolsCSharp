{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },

  // "누가" — 제공사와 에이전트. 서버 시작 시 1회 로드 (바꾸면 Claude Code 재시작).
  // "무엇을 어떤 순서로" — 역할과 모드는 modes.json (실행할 때마다 다시 읽음).
  "Orchestration": {
    "ModesPath": "",
    "GuidelinesPath": "",

    "Providers": {
      "openai": {
        "Type": "openai-compatible",
        "ApiKeyEnv": "OPENAI_API_KEY"
      },
      "gemini": {
        "Type": "openai-compatible",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ApiKeyEnv": "GEMINI_API_KEY"
      },
      "local": {
        // Ollama 기본 주소. LM Studio면 http://localhost:1234/v1
        "Type": "openai-compatible",
        "Endpoint": "http://localhost:11434/v1"
      }
    },

    // 같은 제공사라도 모델이 다르면 에이전트를 따로 둔다. (예: 검증은 상위 모델, 수집 정리는 저가 모델)
    "Agents": [
      { "Name": "gpt_high_sol", "Provider": "openai", "Model": "gpt-5.6-sol",  "MaxOutputTokens": 16000 },
      { "Name": "gpt_main_tera",      "Provider": "openai", "Model": "gpt-5.6-terra",  "MaxOutputTokens": 12000 },
      { "Name": "gpt_mini_luna", "Provider": "openai", "Model": "gpt-5.6-luna",  "MaxOutputTokens": 10000 },
      { "Name": "gemini_argon",   "Provider": "gemini", "Model": "gemini-4-argon",       "MaxOutputTokens": 16000 },
      { "Name": "gemini_flash",   "Provider": "gemini", "Model": "gemini-3.8-flash",       "MaxOutputTokens": 10000 },
      { "Name": "local",    "Provider": "local",  "Model": "<ollama list의 모델>",                          "Enabled": false }
    ],

    "Budget": {
      // 하루 입력+출력 토큰 합계 상한 (0 = 끔). 로컬은 집계 제외.
      "DailyTokenLimit": 300000,
      // run_mode 입력 최대 글자 수. 넘으면 실행하지 않고 줄여달라고 돌려준다.
      "MaxInputChars": 40000,
      // modes.json에 MaxRunsPerSession이 없는 모드의 세션당 실행 한도 (0 = 무제한)
      "DefaultMaxRunsPerSession": 5,
      "FreeProviders": [ "local" ]
    }
  }
}
