    "Providers": {
      "openai": {
        "Type": "openai-compatible",
        "PromptCache": "Off",
        "StructuredOutput": "Schema",
        "ApiKeyEnv": "OPENAI_API_KEY",
        "TimeoutSeconds": 600
      },
      "openai-web": {
        "Type": "openai-responses",
        "ApiKeyEnv": "OPENAI_API_KEY",
        "TimeoutSeconds": 600
      },
      "gemini": {
        "Type": "openai-compatible",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ApiKeyEnv": "GEMINI_API_KEY",
        "TimeoutSeconds": 600,
        "Stream": true
      },
      "local": {
        "Type": "openai-compatible",
        "Endpoint": "http://localhost:11434/v1"
      },
      "fireworks": {
        "Type": "openai-compatible",
        "Endpoint": "https://api.fireworks.ai/inference/v1",
        "ApiKeyEnv": "FIREWORKS_API_KEY",
        "TimeoutSeconds": 600
      },
      "anthropic-cli": {
        "Type": "claude-cli",
        "ApiKeyEnv": "HB_REVIEWER_API_KEY",
        "MonthlyCreditUsd": 100,
        "CreditResetDay": 19,
        "TimeoutSeconds": 900,
        "MaxAttempts": 1
      },
      "codex": {
        "Type": "codex-cli",
        "CodexEvidenceTools": true,
        "CodexEvidenceOriginalRoot": true,
        "TimeoutSeconds": 900,
        "MaxAttempts": 1
      }
    },
