# HB_Tools 설정 — 메모장으로 고친 뒤 저장하면 됩니다.
#   (메뉴 4번으로 열었다면 메모장을 닫는 순간 바로 다시 읽습니다)
# 형식: KEY=VALUE   '=' 앞뒤와 값 끝에 공백을 넣지 마세요.
# '#'으로 시작하는 줄은 주석입니다. 상대 경로는 이 파일이 있는 폴더 기준입니다.
# 값을 비우거나 줄을 지우면 기본값을 씁니다.

# 솔루션 폴더 (HB_Orchestration.slnx가 있는 곳)
SOLUTION_DIR=.

# MCP 서버 publish 출력 폴더 (.mcp.json이 가리키는 dll이 있는 곳)
# 대시보드의 모드 화면도 이 폴더의 appsettings.json / modes.json을 읽고 고칩니다.
PUBLISH_DIR=..\Publish_Output

# 빌드 구성: Release 또는 Debug
CONFIGURATION=Release

# 대시보드 포트
DASHBOARD_PORT=5280
