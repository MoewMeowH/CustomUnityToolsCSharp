{
  "permissions": {
    "allow": [
      "Bash(unity status:*)",
      "Bash(unity list:*)",
      "Bash(unity pipeline list:*)",
      "Bash(unity test:*)",
      "Bash(unity logs:*)",
      "Bash(unity --version)",
      "WebFetch(domain:docs.unity.com)",
      "mcp__hb-orchestration__list_modes"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/cleanup_guard.py\" || exit 2",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/push_guard.py\" || exit 2",
            "timeout": 120,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/share_guard.py\" || exit 2",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/habit_guard.py\" || exit 2",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__hb-orchestration__run_mode",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/run_mode_guard.py\" || exit 2",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/subagent_input_guard.py\" || exit 2",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/plan_ref_guard.py\" || exit 2",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/scripts/commit_notice.py\""
          }
        ]
      }
    ]
  }
}
