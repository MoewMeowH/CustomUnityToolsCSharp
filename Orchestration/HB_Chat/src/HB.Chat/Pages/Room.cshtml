@page "{id}"
@model RoomModel
@{
    ViewData["Title"] = $"HB Chat · {Model.Title}";
}
@* 두 칸 화면 (계획서 2-2 a): 왼쪽 방 목록 + 오른쪽 이 방. 다른 방을 고르면 chat.js가 오른쪽 칸만 바꾼다. *@
<div class="app in-room">
    <partial name="_Sidebar" model="Model.Sidebar" />
    <section class="pane" id="pane">
        <partial name="_RoomPane" model="Model" />
    </section>
</div>
