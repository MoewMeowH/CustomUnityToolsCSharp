@page "{id}"
@model RoomModel
@{
    var room = Model.Room;
    ViewData["Title"] = $"HB Chat · {Model.Title}";
}

<partial name="_ChatStyles" />
<style>
    .room-head { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; padding: 10px 14px; margin-bottom: 12px; }
    .room-head h2 { margin: 0; font-size: 16px; }
    #notice { padding: 8px 12px; margin-bottom: 12px; border-color: var(--warn); }
    #live { max-width: 920px; margin: 10px auto 0; display: flex; flex-direction: column; gap: 10px; }
    #live .msg.pending .bubble { opacity: .7; }
    #live .stream { white-space: pre-wrap; }
    .live-line { text-align: center; font-size: 12.5px; color: var(--muted); }
    .live-line.denied { color: var(--warn); }
    .composer { position: sticky; bottom: 0; background: var(--bg); padding: 10px 0 6px; margin-top: 12px; }
    .composer form { max-width: 920px; margin: 0 auto; display: flex; gap: 8px; align-items: flex-end; }
    .composer textarea { flex: 1; min-height: 44px; max-height: 40vh; resize: vertical; }
    .composer .hint { max-width: 920px; margin: 4px auto 0; font-size: 12px; color: var(--muted); }
    #approvals { max-width: 920px; margin: 10px auto 0; display: flex; flex-direction: column; gap: 8px; }
    .approval { border: 1px solid var(--warn); border-radius: 10px; padding: 8px 12px; background: color-mix(in srgb, var(--warn) 8%, var(--panel)); }
    .approval .head { font-size: 12.5px; color: var(--warn); display: flex; gap: 8px; }
    .approval .cmd { font-family: var(--mono); font-size: 12.5px; white-space: pre-wrap; overflow-wrap: anywhere; margin: 4px 0;
                     max-height: 260px; overflow-y: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; }
    .approval .rule { font-size: 12.5px; margin-top: 4px; }
    .approval .warn-line { font-size: 12px; color: var(--warn); }
    .approval .desc { font-size: 12.5px; color: var(--muted); }
    .approval .acts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; align-items: center; }
    .approval .reason { flex: 1; min-width: 160px; font-size: 12.5px; }
    .rules { max-width: 920px; margin: 0 auto 12px; font-size: 12.5px; }
    .rules li { display: flex; gap: 8px; align-items: center; }
</style>

<p style="margin:0 0 8px"><a href="/">← 방 목록</a></p>

<section class="panel room-head">
    <h2 id="room-title">@Model.Title</h2>
    <span class="muted">@room.Workspace</span>
    <span class="badge" title="@RoomRules.Describe(room.Level)">@RoomRules.LevelName(room.Level)</span>
    <span class="mono muted">@room.Model</span>
    <span class="mono muted" title="이 앱 전용 세션 — Claude 앱 · CLI에서 이어 쓰지 마세요">@room.SessionId</span>
    <span class="muted" title="claude가 알려 준 세션 누적 비용 (클라이언트 추정)" id="cost">@(room.TotalCostUsd is { } cost ? "≈$" + cost.ToString("0.000") : "")</span>
    @if (Model.DashboardLink is { } dash)
    {
        <a href="@dash" target="_blank" rel="noopener">대시보드에서 보기</a>
    }
    <span class="muted" id="conn" style="margin-left:auto"></span>
</section>

<div class="panel" id="notice" hidden></div>
@if (room.LastError is { } lastError)
{
    <div class="panel" style="padding:8px 12px;margin-bottom:12px;border-color:var(--err)" id="last-error">마지막 실행 실패: @lastError</div>
}

@if (room.Level == PermissionLevel.Command)
{
    var inherited = Model.InheritedRules;
    <details class="rules panel" style="padding:8px 12px" @(room.AllowRules.Count + inherited.Count > 0 ? "open" : null)>
        <summary>카드 없이 실행되는 명령 — 이 방 <span id="rule-count">@room.AllowRules.Count</span>개 · 작업 폴더 설정 @(inherited.Count)개</summary>
        <p class="muted" style="margin:6px 0 0">이 방에서 항상 허용 (카드에서 더함, 그 명령이 돌리는 파일이 바뀌어도 다시 묻지 않음):</p>
        <ul id="room-rules" style="margin:4px 0 0;padding-left:0;list-style:none">
            @foreach (var rule in room.AllowRules)
            {
                <li><code class="mono">@rule</code> <button class="btn rule-remove" type="button" data-rule="@rule">지우기</button></li>
            }
        </ul>
        @if (inherited.Count > 0)
        {
            <p class="muted" style="margin:8px 0 0">작업 폴더 · 사용자 설정이 미리 허용 (이 앱에서는 못 지움 — 그 settings 파일에서):</p>
            <ul style="margin:4px 0 0;padding-left:0;list-style:none">
                @foreach (var (source, rule) in inherited)
                {
                    <li><code class="mono">@rule</code> <span class="muted">@source</span></li>
                }
            </ul>
        }
    </details>
}

<partial name="_Messages" model="Model" />
<div id="live"></div>
<div id="approvals"></div>

<div class="composer">
    <form id="send-form" autocomplete="off">
        @Html.AntiForgeryToken()
        <textarea id="text" name="text" placeholder="지휘자에게 말하기 (Enter 보내기 · Shift+Enter 줄바꿈)" maxlength="@RoomHub.MaxPromptChars"></textarea>
        <button class="btn primary" type="submit" id="send">보내기</button>
        <button class="btn" type="button" id="stop" disabled>중지</button>
    </form>
    <div class="hint">@RoomRules.Describe(room.Level)</div>
</div>

<script>
(() => {
    const roomId = @Json.Serialize(room.Id);
    const self = "/Room/" + roomId;
    const form = document.getElementById("send-form");
    const textBox = document.getElementById("text");
    const stopBtn = document.getElementById("stop");
    const live = document.getElementById("live");
    const notice = document.getElementById("notice");
    const conn = document.getElementById("conn");
    const token = form.querySelector("input[name=__RequestVerificationToken]").value;

    const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 120;
    const toBottom = () => window.scrollTo(0, document.documentElement.scrollHeight);
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };

    // 진행 중 턴: 보낸 말(흐리게) + 흘림 글(글자 그대로, 끝나면 세션 기록의 말풍선으로 바뀐다) + 도구 · 거절 줄 + 대기 줄.
    let stream = null, toolLine = null, queueLine = null;
    function bubble(cls, who, text) {
        const m = el("div", "msg " + cls), b = el("div", "bubble");
        m.append(el("div", "avatar", cls.startsWith("user") ? "나" : "C"), b);
        const w = el("div", "who"); w.append(el("b", null, who)); b.append(w);
        const body = el("div", "body stream", text); b.append(body);
        live.append(m);
        return body;
    }
    function showQueue(pending) {
        if (!pending || pending.length === 0) { queueLine?.remove(); queueLine = null; return; }
        if (!queueLine) { queueLine = el("div", "live-line"); }
        queueLine.textContent = "기다리는 말 " + pending.length + "개";
        live.append(queueLine);
    }
    function startTurn(prompt, partial, pending) {
        const follow = atBottom();
        live.replaceChildren();
        toolLine = null; queueLine = null;
        if (prompt) bubble("user pending", "나", prompt);
        stream = bubble("conductor", "지휘자", partial || "…");
        if (!partial) stream.dataset.empty = "1";
        stopBtn.disabled = false;
        showQueue(pending);
        if (follow) toBottom();
    }
    async function refreshMessages() {
        const follow = atBottom();
        try {
            const res = await fetch(self + "?handler=Messages", { cache: "no-store" });
            if (!res.ok) return false;
            const html = await res.text();
            const tmp = document.createElement("div");
            tmp.innerHTML = html; // 서버가 SafeMarkdown · Razor 인코딩으로 만든 같은 출처 HTML
            const fresh = tmp.querySelector("#chat");
            if (fresh) {
                document.getElementById("chat").replaceWith(fresh);
                if (fresh.dataset.title) { document.getElementById("room-title").textContent = fresh.dataset.title; }
            }
            if (follow) toBottom();
            return true;
        } catch { return false; }
    }

    // 승인 카드 (명령 단계): 서버가 답을 기다리는 동안 보인다. 남은 시간은 1초마다 다시 쓴다.
    const approvals = document.getElementById("approvals");
    const cards = new Map();
    function showApproval(a) {
        if (cards.has(a.id)) return;
        const follow = atBottom();
        const card = el("div", "approval");
        const head = el("div", "head");
        const left = el("span"); left.style.marginLeft = "auto";
        head.append(el("span", null, "승인 요청 · " + a.tool), left);
        // 명령 전문(스크롤 칸) — 사용자가 본 것이 허용되는 것과 같게 (/self-review 36e4e20e04 C3 · C5, ab79e61df5 C5).
        card.append(head, el("div", "cmd", a.summary));
        if (a.description) card.append(el("div", "desc", "Claude 설명: " + a.description));
        if (a.truncated) card.append(el("div", "warn-line", "명령이 너무 길어 끝까지 보이지 않습니다 — 거절만 할 수 있습니다."));
        else if (a.rule) {
            const r = el("div", "rule");
            r.append(document.createTextNode("항상 허용하면 저장될 규칙: "), el("code", "mono", a.rule));
            card.append(r, el("div", "warn-line", "항상 허용하면 이 명령은 다음부터 묻지 않습니다 — 이 명령이 돌리는 파일(스크립트 · package.json · 프로젝트 파일 등)이 바뀌어도 그대로 실행됩니다."));
        }
        const acts = el("div", "acts");
        const button = (label, choice, extra) => {
            const b = el("button", "btn" + (extra ? " " + extra : ""), label);
            b.type = "button";
            b.addEventListener("click", () => decide(a.id, choice, card));
            acts.append(b);
            return b;
        };
        if (!a.truncated) {
            button("허용", "allow", "primary");
            if (a.rule) button("이 방에서 항상 허용", "always");
        }
        const reasonBox = el("input", "reason");
        reasonBox.type = "text"; reasonBox.maxLength = 500; reasonBox.placeholder = "거절 이유 (선택, 지휘자에게 전해짐)";
        reasonBox.addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.isComposing) { e.preventDefault(); decide(a.id, "deny", card); } });
        acts.append(reasonBox);
        button("거절", "deny");
        card.append(acts);
        card.dataset.expires = String(Date.parse(a.expiresAt));
        card.left = left;
        approvals.append(card);
        cards.set(a.id, card);
        tickApprovals();
        if (follow) toBottom();
    }
    function doneApproval(a, label) {
        const card = cards.get(a.id);
        if (!card) return;
        cards.delete(a.id);
        card.remove();
        live.insertBefore(el("div", "live-line" + (label === "허용" || label === "항상 허용" ? "" : " denied"),
            "승인 " + (label || "끝남") + " — " + a.tool + ": " + a.summary.slice(0, 120)), queueLine);
    }
    async function decide(id, choice, card) {
        const reason = choice === "deny" ? card.querySelector("input.reason")?.value.trim() : null;
        const buttons = card.querySelectorAll("button");
        buttons.forEach(b => b.disabled = true);
        const data = new FormData();
        data.append("approval", id); data.append("choice", choice);
        if (reason) data.append("reason", reason);
        if (!await post("Approve", data)) buttons.forEach(b => b.disabled = false);
    }
    function tickApprovals() {
        for (const card of cards.values()) {
            const s = Math.max(0, Math.round((Number(card.dataset.expires) - Date.now()) / 1000));
            card.left.textContent = "남은 시간 " + Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
        }
    }
    setInterval(tickApprovals, 1000);
    // 이 방의 "항상 허용" 목록: 처음엔 서버가 그리고, 바뀌면 rules 알림으로 다시 그린다 (/self-review 36e4e20e04 C9).
    function removeButton(rule) {
        const b = el("button", "btn rule-remove", "지우기");
        b.type = "button";
        b.addEventListener("click", async () => {
            if (!confirm("이 규칙을 지울까요? 다음 실행부터 다시 묻습니다.\n" + rule)) return;
            const data = new FormData(); data.append("rule", rule);
            await post("RemoveRule", data); // 목록은 rules 알림으로 바뀐다
        });
        return b;
    }
    function renderRules(rules) {
        const list = document.getElementById("room-rules");
        if (!list) return;
        list.replaceChildren(...rules.map(rule => {
            const li = el("li");
            li.append(el("code", "mono", rule), document.createTextNode(" "), removeButton(rule));
            return li;
        }));
        const count = document.getElementById("rule-count");
        if (count) count.textContent = String(rules.length);
    }
    document.querySelectorAll(".rule-remove").forEach(b => b.replaceWith(removeButton(b.dataset.rule)));

    // 알림은 온 차례대로 하나씩 처리한다. EventSource는 onmessage가 끝나기를 기다리지 않아,
    // end의 말풍선 다시 받기(fetch) 중에 다음 턴의 start가 먼저 그려졌다가 지워지는 일이 있었다 (/self-review 0a3b1d5155 C1).
    let chain = Promise.resolve();
    function connect() {
        const es = new EventSource("/events/" + roomId);
        es.onopen = () => { conn.textContent = ""; };
        es.onerror = () => { conn.textContent = "연결 끊김 · 다시 시도 중"; };
        es.onmessage = (msg) => {
            const ev = JSON.parse(msg.data);
            chain = chain.then(() => handle(ev)).catch(() => { });
        };
    }
    async function handle(ev) {
        switch (ev.kind) {
            case "snapshot":
                // 처음 붙거나 다시 붙을 때: 그사이 끝난 턴이 있을 수 있으니 말풍선부터 다시 받는다 (0a3b1d5155 C3).
                await refreshMessages();
                if (ev.busy) startTurn(ev.prompt, ev.text, ev.pending);
                else { live.replaceChildren(); stream = null; toolLine = null; queueLine = null; stopBtn.disabled = true; }
                approvals.replaceChildren(); cards.clear(); // 기다리는 카드는 snapshot 뒤 approval로 다시 온다
                break;
            case "approval":
                showApproval(ev.approval);
                break;
            case "approval-done":
                doneApproval(ev.approval, ev.text);
                break;
            case "rules":
                renderRules(ev.rules || []);
                break;
            case "start":
                document.getElementById("last-error")?.remove();
                notice.hidden = true;
                startTurn(ev.prompt, "", ev.pending);
                break;
            case "delta": {
                if (!stream) startTurn(null, "", null);
                const follow = atBottom();
                if (stream.dataset.empty) { stream.textContent = ""; delete stream.dataset.empty; }
                stream.append(ev.text); // 글 조각을 텍스트 노드로 덧붙인다 (+= 는 매번 전체를 다시 만든다 — C11)
                if (follow) toBottom();
                break;
            }
            case "tool":
                if (!toolLine) { toolLine = el("div", "live-line"); live.insertBefore(toolLine, queueLine); }
                toolLine.textContent = "도구: " + ev.text;
                break;
            case "denied":
            case "retry":
                live.insertBefore(el("div", "live-line " + ev.kind, (ev.kind === "denied" ? "거절됨 — " : "") + ev.text), queueLine);
                break;
            case "queued":
                showQueue(ev.pending);
                break;
            case "notice":
                notice.textContent = ev.text; notice.hidden = false;
                break;
            case "end": {
                // 이 턴의 말은 세션 기록으로 다시 그린다. 다시 받지 못하면 진행 중 말풍선을 남겨 둔다 (지휘자 검토 R7).
                // 실패 · 중지면 이유를 한 줄 남긴다.
                const refreshed = await refreshMessages();
                if (refreshed) live.querySelectorAll(".msg").forEach(m => m.remove());
                else live.prepend(el("div", "live-line denied", "말풍선을 다시 받지 못했습니다 — 새로고침하면 보입니다."));
                stream = null; toolLine?.remove(); toolLine = null;
                if (!ev.ok && ev.text) live.prepend(el("div", "live-line denied", ev.text));
                if (ev.costUsd != null) { const c = document.getElementById("cost"); if (c) c.textContent = "≈$" + ev.costUsd.toFixed(3); }
                break;
            }
            case "idle":
                stopBtn.disabled = true;
                showQueue([]);
                break;
        }
    }

    async function post(handler, data) {
        data.append("__RequestVerificationToken", token);
        const res = await fetch(self + "?handler=" + handler, { method: "POST", body: data });
        if (!res.ok) { alert(await res.text() || ("요청 실패 " + res.status)); return false; }
        return true;
    }
    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = textBox.value;
        if (!text.trim()) return;
        // 보내기 전에 바로 비운다: 응답을 기다리는 사이 이어 쓴 글이 앞 글에 붙어 같이 나가지 않게 (실제 확인에서 발견).
        // 실패하면 비어 있을 때만 되돌린다.
        textBox.value = "";
        const data = new FormData(); data.append("text", text);
        if (!await post("Send", data) && !textBox.value) textBox.value = text;
    });
    textBox.addEventListener("keydown", (e) => {
        // 한글 조합 중 Enter는 글자 확정이다 — 보내지 않는다.
        if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); form.requestSubmit(); }
    });
    stopBtn.addEventListener("click", () => post("Stop", new FormData()));

    toBottom();
    connect();
})();
</script>
