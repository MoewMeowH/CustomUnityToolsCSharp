@model RoomModel
@*
    곁칸의 방 정보 · 외부 실행 · 첨부 탭 (3차 c). 화면이 곁칸을 열 때 · 턴이 끝날 때 ?handler=Side로 받아 #side-data를 바꾼다.
    단계 탭은 _RoomPane에 있고 steps 알림으로 그린다. 글은 모두 Razor 인코딩.
*@
@{
    var room = Model.Room;
    static string Size(long bytes) => bytes switch
    {
        < 1024 => $"{bytes}B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#}KB",
        _ => $"{bytes / 1024.0 / 1024.0:0.#}MB",
    };
}
<section class="side-sec" data-tab="info" id="side-sec-info" role="tabpanel" aria-labelledby="side-tab-info">
    @* 제목 바꾸기 — 방 머리 · ⋯ 메뉴와 같은 Rename (결정: "방의 제목도 변경이 가능했음 좋긴행") *@
    <form class="side-rename" id="side-rename">
        <label class="muted" for="side-title">제목</label>
        <input type="text" id="side-title" maxlength="200" value="@(room.Title ?? "")" placeholder="비우면 첫 말 (@Model.Title)" />
        <button class="btn" type="submit">@Icons.Svg("check") 바꾸기</button>
    </form>
    @* 모델 · 추론 강도 · 권한 단계 (Claude 앱 기능 B): 다음 말부터 반영. 단계는 올리기 · 내리기 모두 (결정) *@
    <form class="side-settings" id="side-settings">
        @* 그릴 때의 단계 — 서버가 지금 값과 다르면 거절한다 (옛 곁칸이 방금 내린 단계를 다시 올리지 않게, 8ccecae84d C2) *@
        <input type="hidden" name="expectedLevel" value="@room.Level" />
        <label><span class="muted">모델</span>
            <select name="model">
                @foreach (var m in Model.Models)
                {
                    <option value="@m" selected="@(m == room.Model)">@m</option>
                }
                @if (!Model.Models.Contains(room.Model))
                {
                    <option value="@room.Model" selected disabled>@room.Model (허용 목록에 없음)</option>
                }
            </select>
        </label>
        <label><span class="muted">추론 강도</span>
            <select name="effort">
                <option value="" selected="@(room.Effort is null)">@RoomEffort.Name(null)</option>
                @foreach (var e in RoomEffort.Levels)
                {
                    <option value="@e" selected="@(e == room.Effort)">@RoomEffort.Name(e)</option>
                }
            </select>
        </label>
        <label><span class="muted">권한</span>
            <select name="level">
                @foreach (var lv in Enum.GetValues<PermissionLevel>())
                {
                    <option value="@lv" selected="@(lv == room.Level)" title="@RoomRules.Describe(lv)">@RoomRules.LevelName(lv)</option>
                }
            </select>
        </label>
        <button class="btn" type="submit">@Icons.Svg("check") 바꾸기</button>
        <p class="muted side-settings-note">다음 말부터 적용됩니다 — 명령 아래로 내리면 실행 중인 턴의 명령도 바로 거절됩니다. @RoomRules.Describe(room.Level)</p>
        @* 명령이 아닌 방에 남은 "항상 허용" 규칙: 다시 명령으로 올리면 묻지 않고 쓰인다 — 내용을 보인다 (8ccecae84d C3) *@
        @if (room.Level != PermissionLevel.Command && room.AllowRules.Count > 0)
        {
            <div class="side-settings-note warn-rules">
                <span>다시 명령으로 올리면 승인 없이 쓰일 '항상 허용' 규칙 @(room.AllowRules.Count)개:</span>
                <ul>
                    @foreach (var rule in room.AllowRules)
                    {
                        <li class="mono">@rule</li>
                    }
                </ul>
            </div>
        }
    </form>
    <dl class="side-info">
        <dt>작업 폴더</dt><dd>@room.Workspace <span class="mono muted">@(Model.WorkspacePath ?? "(허용 목록에 없음)")</span></dd>
        <dt>세션</dt><dd class="mono" title="이 앱 전용 세션 — Claude 앱 · CLI에서 이어 쓰지 마세요">@room.SessionId</dd>
        <dt>컨텍스트</dt><dd>@(room.ContextTokens is { } t ? RoomModel.Tokens(t) + (room.ContextWindow is > 0 and var w ? " / " + RoomModel.Tokens(w) : "") : "—")</dd>
        <dt>비용</dt><dd title="claude가 알려 준 세션 누적 비용 (클라이언트 추정)">@(room.TotalCostUsd is { } cost ? "≈$" + cost.ToString("0.000") : "—")</dd>
        <dt>만든 때</dt><dd>@room.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        <dt>마지막 실행</dt><dd>@(room.LastRunAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
        @* 이 방 스티커 팩 (4차 D2 — 결정 "전체 + 방별"): 비우면 전체 설정(설정 화면)을 따른다.
           팩이 없으면 줄을 숨기되, 이 방에 고른 값이 남아 있으면 보인다 — 되돌릴 수 있게 (ef2c83416c C9) *@
        @{ var packList = Model.Packs.List(); }
        @if (packList.Count > 0 || room.StickerPack is not null)
        {
            var global = Model.Packs.Effective((string?)null);
            var globalName = global is null ? "기본" : packList.FirstOrDefault(p => p.Id == global)?.Name ?? global;
            <dt><label for="side-pack">스티커 팩</label></dt>
            <dd>
                <select id="side-pack">
                    <option value="" selected="@(room.StickerPack is null)">전체 설정 따름 (@globalName)</option>
                    @foreach (var p in packList)
                    {
                        <option value="@p.Id" selected="@(room.StickerPack == p.Id)">@p.Name</option>
                    }
                    @if (room.StickerPack is { } gone && packList.All(p => p.Id != gone))
                    {
                        <option value="@gone" selected>@gone (폴더 없음 — 전체 설정 '@(globalName)'(으)로 보임)</option>
                    }
                </select>
            </dd>
        }
        @* 서브에이전트 (Claude 앱 기능 D, 결정 "보인다"): 마지막 실행의 init 목록. 방 단계의 도구 · 규칙 · 승인을 그대로 따른다 *@
        @if (ClaudeArgs.AllowsAgents(room.Level))
        {
            <dt>서브에이전트</dt>
            <dd>@(Model.Agents is { Count: > 0 } agents ? string.Join(" · ", agents) : "이 방이 한 번 돈 뒤에 보입니다") <span class="muted">(이 방 권한 안에서만)</span></dd>
        }
        else if (room.Level == PermissionLevel.Command)
        {
            @* 명령 방은 서브에이전트를 쓰지 않는다 (/self-review security 42f9d47dc4 C1) *@
            <dt>서브에이전트</dt>
            <dd class="muted">명령 방에서는 쓰지 않습니다 — 에이전트 정의가 명령 승인을 건너뛸 수 있어서 (읽기 · 편집 방에서 쓰세요)</dd>
        }
        @if (room.Level == PermissionLevel.Command)
        {
            <dt>항상 허용</dt><dd>이 방 @(room.AllowRules.Count)개 <span class="muted">(목록은 대화 위 접힌 칸)</span></dd>
        }
        @if (Model.DashboardLink is { } dash)
        {
            <dt>대시보드</dt><dd><a href="@dash" target="_blank" rel="noopener">채팅방 열기</a></dd>
        }
    </dl>
</section>
<section class="side-sec" data-tab="runs" id="side-sec-runs" role="tabpanel" aria-labelledby="side-tab-runs">
    @{ var runs = Model.SideRuns; }
    @if (runs.Count == 0)
    {
        <p class="muted">이 방에서 부른 외부 에이전트 실행(run_mode)이 없습니다.</p>
    }
    <ul class="side-list">
        @foreach (var r in runs)
        {
            <li>
                <span class="mono">@r.Mode</span>
                <span class="muted">@r.At.ToLocalTime().ToString("MM-dd HH:mm") · 응답 @r.Replies@(r.Errors > 0 ? " · " : "")</span>@if (r.Errors > 0)
                {
                    <span class="err">실패 @r.Errors</span>
                }
                @if (r.Link is { } link)
                {
                    <a href="@link" target="_blank" rel="noopener" title="대시보드 실행 화면">@r.RunId</a>
                }
                else
                {
                    <span class="mono muted">@r.RunId</span>
                }
            </li>
        }
    </ul>
</section>
@* 연결 (계획서 2026-10-29_HB_Chat-방별-MCP-Unity-연결 — Claude 앱 커넥터처럼): 종류 · 켬 · 상태 · 도구 · 확인. 다음 실행부터 반영 *@
<section class="side-sec" data-tab="mcp" id="side-sec-mcp" role="tabpanel" aria-labelledby="side-tab-mcp">
    @* 결정 4: 더한 서버는 단계와 상관없이 묻지 않는다 — 단계 설명과 다른 점을 적는다 (/self-review security 00d712e2c7 C2) *@
    <p class="muted side-settings-note">다음 말부터 적용됩니다. 켠 연결의 도구는 지휘자가 <b>묻지 않고</b> 씁니다 — 방 권한 단계와 상관없이 (읽기 방이어도 그 서버의 쓰기 도구는 돕니다). 끄거나 권한을 내리면 실행 중인 턴에서도 바로 막힙니다. 상태는 이 방 마지막 실행 · '확인' 결과입니다.</p>
    <ul class="mcp-list">
        @foreach (var c in Model.Connections)
        {
            var kind = c.Kind switch { "base" => "기본", "app" => "앱", "unity" => "Unity", "appserver" => "앱 서버", _ => "작업 폴더" };
            var probe = c.Probe;
            var tools = c.ShownTools;
            <li class="mcp-item @(c.On && c.Applies ? "" : "off")">
                <div class="mcp-head">
                    <span class="mcp-name mono">@c.Name</span>
                    <span class="mcp-tag">@kind</span>
                    <span class="mcp-tag">@c.Transport</span>
                    @if (c.Kind != "unity")
                    {
                        <label class="switch mcp-switch" title="@(c.On ? "이 방에서 끄기" : "이 방에서 켜기")">
                            <input type="checkbox" data-mcp="@c.Name" checked="@c.On" aria-label="@c.Name 켜기" />
                            <span class="track"></span>
                        </label>
                    }
                </div>
                @if (c.Command is { } cmd)
                {
                    <div class="mcp-cmd mono muted" title="@cmd">@cmd</div>
                }
                @* 앱 서버 (계획서 2026-10-29_HB_Chat-앱-MCP-서버-더하기): 이름 겹침 · OAuth 로그인 안내 *@
                @if (c.Shadowed)
                {
                    <div class="muted side-settings-note">앱 서버 목록에도 같은 이름이 있습니다 — 이 작업 폴더 .mcp.json 것을 씁니다.</div>
                }
                @if (c.NeedsLogin)
                {
                    <div class="muted side-settings-note">OAuth로 로그인하는 서버(Notion 등)는 터미널 claude의 /mcp에서 한 번 로그인해 두면 이 방에서도 붙습니다.</div>
                }
                <div class="mcp-state">
                    @if (c.Note is { } note)
                    {
                        <span class="muted">@note</span>
                    }
                    else if (!c.On)
                    {
                        <span class="muted">꺼짐</span>
                    }
                    else
                    {
                        <span class="mcp-dot @(c.Init switch { "connected" => "ok", null => "", _ => "bad" })"></span>
                        @* 상태는 마지막 실행 init (방에 저장 — 앱을 다시 켜도 남음). 마지막 실행에 없던 연결(막 켬)은 다음 실행부터 붙는다 (지휘자 검토 K6) *@
                        <span>@(c.Init switch
                        {
                            "connected" => "연결됨",
                            null when room.McpStatusAt is null => "아직 상태 없음 — 이 방에서 말을 보내면 보입니다",
                            null => "다음 실행부터 붙습니다",
                            var s => s,
                        })</span>
                        @if (c.Init is not null && room.McpStatusAt is { } at)
                        {
                            <span class="muted" title="이 방 마지막 실행이 시작될 때 claude가 알려 준 상태">(마지막 실행 @at.ToLocalTime().ToString("MM-dd HH:mm"))</span>
                        }
                    }
                    @if (probe is not null)
                    {
                        <span class="muted"> · 확인 @probe.At.ToLocalTime().ToString("HH:mm") — </span>
                        @if (probe.Ok)
                        {
                            <span>도구 @(probe.Tools.Count)개 (@(probe.Millis)ms)</span>
                            @if (c.Kind == "unity" && probe.Tools.Count == 0)
                            {
                                <span class="warn-text"> — 에디터가 꺼져 있습니다 (그 프로젝트 에디터를 켜야 도구가 보입니다)</span>
                            }
                        }
                        else if (probe.NeedsLogin)
                        {
                            @* OAuth 서버(Notion 등): claude는 로그인 토큰으로 붙지만 앱은 확인할 수 없다 — 실패가 아님 *@
                            <span class="muted">@probe.Error</span>
                        }
                        else
                        {
                            <span class="warn-text">실패: @probe.Error</span>
                        }
                    }
                    @if (c.Kind != "app")
                    {
                        <button type="button" class="btn mcp-probe" data-probe="@c.Name" disabled="@c.Probing">@(c.Probing ? "확인 중…" : "확인")</button>
                    }
                </div>
                @if (tools is { Count: > 0 })
                {
                    <details class="mcp-tools">
                        <summary>도구 @(tools.Count)개</summary>
                        <ul>
                            @foreach (var (name, desc) in tools.Take(300))
                            {
                                <li><span class="mono">@name</span>@if (!string.IsNullOrWhiteSpace(desc))
                                    {
                                        <span class="muted"> — @(desc.Length > 160 ? desc[..160] + "…" : desc)</span>
                                    }</li>
                            }
                        </ul>
                    </details>
                }
            </li>
        }
    </ul>
    @* Unity 프로젝트 연결 (결정: 명령 방만 · 권한 나누지 않음 — 연결하면 편집) *@
    <div class="mcp-unity">
        <label for="side-unity"><b>Unity 프로젝트</b></label>
        @if (room.Level != PermissionLevel.Command && room.UnityProject is null)
        {
            <p class="muted side-settings-note">명령 방에서만 연결합니다.</p>
        }
        else if (Model.UnityProjects.Count == 0 && room.UnityProject is null)
        {
            <p class="muted side-settings-note">설정 화면에서 Unity 프로젝트를 먼저 더하세요.</p>
        }
        else
        {
            <select id="side-unity">
                <option value="" selected="@(room.UnityProject is null)">연결 안 함</option>
                @foreach (var u in Model.UnityProjects)
                {
                    <option value="@u.Name" selected="@(string.Equals(u.Name, room.UnityProject, StringComparison.OrdinalIgnoreCase))" disabled="@(room.Level != PermissionLevel.Command)">@u.Name</option>
                }
                @if (room.UnityProject is { } gone && Model.UnityProjects.All(u => !string.Equals(u.Name, gone, StringComparison.OrdinalIgnoreCase)))
                {
                    <option value="@gone" selected>@gone (설정에 없음)</option>
                }
            </select>
            <p class="muted side-settings-note">연결하면 지휘자가 열린 에디터를 묻지 않고 조작합니다 (씬 · 에셋 편집 · 빌드 · 패키지 포함). C# 코드 실행(eval · eval_file · run_script)만 카드로 묻습니다 — 허용한 코드는 편집 금지 경로도 막지 못합니다. capture_game_view 그림은 대화 기록에 남습니다.</p>
        }
    </div>
</section>
<section class="side-sec" data-tab="files" id="side-sec-files" role="tabpanel" aria-labelledby="side-tab-files">
    @{ var files = Model.AttachmentFiles; }
    @if (files.Count == 0)
    {
        <p class="muted">이 방에 올린 첨부가 없습니다.</p>
    }
    <ul class="side-list">
        @foreach (var f in files.Take(Attachments.MaxListed))
        {
            <li>
                <a href="/Room/@room.Id?handler=Attachment&amp;name=@Uri.EscapeDataString(f.Name)" target="_blank" rel="noopener">@f.Name</a>
                <span class="muted">@Size(f.Bytes) · @f.At.ToLocalTime().ToString("MM-dd HH:mm")</span>
            </li>
        }
    </ul>
    @if (files.Count > Attachments.MaxListed)
    {
        <p class="muted">최근 @(Attachments.MaxListed)개만 보입니다.</p>
    }
</section>
