@model RoomModel
@inject ProfileView Profiles
@*
    오른쪽 방 칸. 첫 화면(Room.cshtml)과 방 전환(?handler=Pane)이 같이 쓴다. 동작은 wwwroot/chat.js의 mountRoom.
*@
@{
    var room = Model.Room;
    var face = Model.Face;
    var faceUrl = Model.Faces.Url(face, Model.Stickers);
}
<div class="room" data-room="@room.Id" data-title="@Model.Title" data-read-up-to="@(room.ReadUpTo ?? -1)"
     data-faces="@Model.Faces.Json(Model.Stickers)" data-profiles="@Profiles.Json()" data-face="@face" data-face-left="@Model.EndFaceLeftMs" data-end-face-ms="@RoomModel.EndFaceMs">
    @* 가운데(머리 · 말 · 입력칸) + 오른쪽 곁칸 (3차 c) *@
    <div class="room-main">
    <section class="room-head">
        <a class="back" href="/" title="방 목록" aria-label="방 목록">@Icons.Svg("back")</a>
        @* 지휘자 표정: 상태마다 스티커 그림, 그림이 없으면 글자 아바타 *@
        <div class="avatar face" id="face">
            <img id="face-img" alt="" src="@faceUrl" @(faceUrl is null ? "hidden" : null) />
            <span id="face-letter" @(faceUrl is null ? null : "hidden")>@Profiles.Letter(ProfileStore.Conductor, Profiles.ConductorName)</span>
        </div>
        <div class="head-title">
            <h2 id="room-title" title="눌러서 이름 바꾸기">@Model.Title</h2>
            <span class="muted" id="face-label">@FaceCatalog.Label(face)</span>
            @* 지휘자 상태 한 줄 (CLI post_turn_summary, 3차 b) — 사용자가 할 일이 있으면 그것을 *@
            @{ var st = room.Status; var stLine = st?.NeedsAction ?? st?.Detail; var stText = (st?.NeedsAction is not null ? "할 일: " : "") + stLine; }
            @* title은 전체 글 — 말줄임된 뒷부분을 마우스로 본다 *@
            <span class="status-line@(st?.NeedsAction is not null ? " needs" : "")" id="status-line" title="@stText"
                  @(stLine is null ? "hidden" : null)>@stText</span>
        </div>
        <span class="badge" title="@RoomRules.Describe(room.Level)">@RoomRules.LevelName(room.Level)</span>
        <span class="mono muted" title="모델 · 추론 강도 (곁칸 방 정보에서 바꿈)">@Model.ModelLabel@(room.Effort is { } effort ? " · " + effort : "")</span>
        <span class="ctx" id="ctx" title="마지막 턴이 끝날 때의 컨텍스트 크기 / 모델 컨텍스트 창 (토큰, claude stream-json usage)"
              data-window="@(room.ContextWindow ?? 0)" @(room.ContextTokens is null ? "hidden" : null)>
            <span class="ctx-bar"><span id="ctx-fill" style="width:@(room.ContextTokens is { } t && room.ContextWindow is > 0 and var w ? Math.Min(100, t * 100.0 / w).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "0")%"></span></span>
            <span id="ctx-text">@(room.ContextTokens is { } tokens ? "컨텍스트 " + RoomModel.Tokens(tokens) + (room.ContextWindow is > 0 and var win ? " / " + RoomModel.Tokens(win) : "") : "")</span>
        </span>
        <span class="muted" title="claude가 알려 준 세션 누적 비용 (클라이언트 추정)" id="cost">@(room.TotalCostUsd is { } cost ? "≈$" + cost.ToString("0.000") : "")</span>
        <span class="muted" id="conn" style="margin-left:auto"></span>
        @if (Model.DashboardLink is { } dash)
        {
            <a href="@dash" target="_blank" rel="noopener" class="icon-link" title="대시보드 채팅방 (run_mode 실행 · 판정 엮임)">@Icons.Svg("dashboard") 대시보드</a>
        }
        @* 곁칸 열고 닫기 (3차 c) — 열림 · 고른 탭은 브라우저 저장 *@
        <button type="button" class="btn" id="side-toggle" title="오른쪽 곁칸: 단계 · 방 정보 · 외부 실행 · 첨부" aria-controls="side" aria-expanded="false">@Icons.Svg("panel") 정보</button>
        @* 방 메뉴 — 메뉴 단추는 아이콘만, 항목은 아이콘 + 글 (4차 D3) *@
        <details class="menu">
            <summary class="btn icon-only" title="방 메뉴" aria-label="방 메뉴">@Icons.Svg("more")</summary>
            <div class="menu-items">
                <button type="button" class="menu-rename">@Icons.Svg("pencil") 이름 바꾸기</button>
                <button type="button" class="menu-fork" title="이 방 대화를 이어받는 새 방 (새 방에 첫 말을 보낼 때 그때까지의 대화가 복사됨)">@Icons.Svg("branch") 방 복제 (갈래)</button>
                <a href="/Room/@room.Id?handler=Export" download>@Icons.Svg("download") Markdown 내보내기</a>
                @if (room.DeletedAt is null)
                {
                    <button type="button" class="menu-trash">@Icons.Svg("trash") 휴지통으로</button>
                }
                <span class="mono muted menu-session" title="이 앱 전용 세션 — Claude 앱 · CLI에서 이어 쓰지 마세요">세션 @room.SessionId</span>
            </div>
        </details>
    </section>

    <div class="scroll">
        @if (Model.ParentGroup is { } parentGroup)
        {
            @* 단톡방 구성원의 과정 보기: 말은 단톡방에서 — 여기서는 도구 · 승인 · 질문 카드만 *@
            <div class="panel banner muted" id="group-child-banner">
                단톡방 <a href="/Room/@parentGroup.Id">@parentGroup.Title</a>의 구성원 방(과정 보기)입니다 — 말은 단톡방에서 @@이름으로 보내세요. 여기서는 도구 사용 · 승인 · 질문 카드를 보고 답합니다.
            </div>
        }
        @if (room.DeletedAt is { } deletedAt)
        {
            <div class="panel banner" id="trash-banner">
                휴지통에 있는 방입니다 — @Trash.DaysLeft(room, DateTimeOffset.Now)일 뒤 방 목록에서 완전히 지웁니다 (세션 기록은 남음). 말을 보내려면 되살리세요.
                <button type="button" class="btn menu-restore">@Icons.Svg("restore") 되살리기</button>
            </div>
        }
        @if (room.ForkOf is { } forkOf)
        {
            @* 갈라지는 때는 첫 말을 보낼 때다 — 그 사이 원래 방이 더 진행됐으면 알린다 (/self-review 95e8b1c242 C2) *@
            <div class="panel banner muted">
                갈래 방 — 첫 말을 보낼 때 원래 방(세션 <span class="mono">@forkOf</span>)의 <b>그때까지</b> 대화를 이어받습니다.
                @if (Model.ForkSourceGrew)
                {
                    <br /><span style="color:var(--warn)">원래 방이 이 갈래를 만든 뒤로 더 진행됐습니다 — 그 뒤 대화도 함께 이어받습니다.</span>
                }
            </div>
        }
        <div class="panel" id="notice" hidden></div>
        @if (room.LastError is { } lastError)
        {
            <div class="panel" style="padding:8px 12px;margin-bottom:12px;border-color:var(--err)" id="last-error">마지막 실행 실패: @lastError</div>
        }

        @if (room.Level == PermissionLevel.Command)
        {
            var inherited = Model.InheritedRules;
            <details class="rules panel" style="padding:8px 12px" @(room.AllowRules.Count + inherited.Count > 0 ? "open" : null)>
                <summary>카드 없이 실행되는 명령 — 이 방 <span id="rule-count">@room.AllowRules.Count</span>개 · 작업 폴더 설정 @(inherited.Count)개</summary>
                <p class="muted" style="margin:6px 0 0">이 방에서 항상 허용 (카드에서 더함, 그 명령이 돌리는 파일이 바뀌어도 다시 묻지 않음):</p>
                <ul id="room-rules" style="margin:4px 0 0;padding-left:0;list-style:none">
                    @foreach (var rule in room.AllowRules)
                    {
                        <li><code class="mono">@rule</code> <button class="btn rule-remove" type="button" data-rule="@rule">@Icons.Svg("x") 지우기</button></li>
                    }
                </ul>
                @if (inherited.Count > 0)
                {
                    <p class="muted" style="margin:8px 0 0">작업 폴더 · 사용자 설정이 미리 허용 (이 앱에서는 못 지움 — 그 settings 파일에서):</p>
                    <ul style="margin:4px 0 0;padding-left:0;list-style:none">
                        @foreach (var (source, rule) in inherited)
                        {
                            <li><code class="mono">@rule</code> <span class="muted">@source</span></li>
                        }
                    </ul>
                }
            </details>
        }

        @if (room.Engine == RoomEngines.Codex)
        {
            <partial name="_CodexLog" model="Model" />
        }
        <partial name="_Messages" model="Model" />
        @* 진행 중 턴: 보낸 말 · 흘림 글 · 도구 칩 · 승인 카드(흐름 안, 2-2 b) · 기다리는 말 *@
        <div id="live"></div>
    </div>

    @{
        var canAttach = room.Level != PermissionLevel.Chat && room.DeletedAt is null;
        var noAttachWhy = room.DeletedAt is not null ? "휴지통에 있는 방입니다 — 되살린 뒤 첨부하세요."
            : "대화 단계 방은 파일을 열 도구가 없어 첨부를 받지 않습니다.";
    }
    <div class="composer" @(Model.ParentGroup is not null ? "hidden" : null) data-attach="@(canAttach ? "1" : "0")" data-attach-why="@(canAttach ? null : noAttachWhy)"
         data-attach-max="@Attachments.MaxPerMessage" data-attach-bytes="@Attachments.MaxBytes">
        @* 진행 단계 (3차 b): 지휘자 할 일 목록 — 화면이 snapshot · steps 알림으로 그린다 *@
        <details class="steps" id="steps" hidden><summary id="steps-summary"></summary><ol id="steps-list"></ol></details>
        @* 기다리는 말 (하나씩 취소 · 지금 보내기, 2-2 d · 3차 b) — 화면이 queued · start · snapshot 알림으로 그린다 *@
        <div class="queue" id="queue" hidden></div>
        <div class="quote" id="quote" hidden>
            <span class="quote-text" id="quote-text"></span>
            <button class="btn icon-only quote-x" type="button" id="quote-x" title="인용 빼기" aria-label="인용 빼기">@Icons.Svg("x")</button>
        </div>
        @* 첨부 칩 (2-2 d): 끌어 놓기 · 캡처 붙여 넣기 · 첨부 단추로 올리면 바로 그 방 첨부 폴더에 저장되고, 보낼 때 [첨부] 줄로 붙는다 *@
        <div class="attach-chips" id="attach-chips" hidden></div>
        @* 계획 먼저 (Claude 앱 기능 C, 결정 "입력칸 토글" · "편집 · 명령 방만"): 다음 말을 계획 모드로 — 계획을 승인하면 저절로 꺼진다 *@
        @{
            var showPlan = ClaudeArgs.PlanMode(room.Level) is not null && room.DeletedAt is null;
        }
        @if (showPlan || Model.CanModeRequest)
        {
            <div class="plan-row">
                @if (showPlan)
                {
                    <label class="switch" title="켜면 다음 말은 지휘자가 먼저 계획을 세워 계획 카드로 묻습니다. 승인하면 바로 진행하고 이 스위치는 꺼집니다.">
                        <input type="checkbox" id="plan-next" checked="@room.PlanNext" />
                        <span class="track"></span>
                        계획 먼저
                    </label>
                }
                @* 모델 선택창 (결정 "방 설정 스위치"): 다음 실행부터 run_mode를 카드로 묻는다 *@
                @if (Model.CanModeRequest)
                {
                    <label class="switch" title="켜면 지휘자가 외부 에이전트(run_mode)를 부를 때마다 카드로 묻습니다 — 에이전트 · 추론 강도를 바꿔 허가하거나 거절합니다. 다음 실행부터 적용됩니다.">
                        <input type="checkbox" id="ask-run-mode" checked="@room.AskRunMode" />
                        <span class="track"></span>
                        외부 요청 전에 묻기
                    </label>
                }
            </div>
        }
        @* + 요청 창에서 고른 외부 요청 — 보낼 때 머리 줄을 붙여 보낸다. 화면이 그린다 *@
        <div class="quote mode-chip" id="mode-chip" hidden>
            <span class="quote-text" id="mode-chip-text"></span>
            <button class="btn icon-only quote-x" type="button" id="mode-chip-x" title="외부 요청 빼기" aria-label="외부 요청 빼기">@Icons.Svg("x")</button>
        </div>
        <div class="mode-pick" id="mode-pick" hidden></div>
        <form id="send-form" autocomplete="off">
            @Html.AntiForgeryToken()
            @* + 메뉴: 파일 첨부 · 외부 에이전트 요청 *@
            @if (canAttach || Model.CanModeRequest)
            {
                <div class="plus-wrap">
                    <button class="btn attach-btn" type="button" id="plus-btn" aria-haspopup="menu" aria-expanded="false" title="첨부 · 외부 에이전트 요청">@Icons.Svg("attach") +</button>
                    <div class="plus-menu" id="plus-menu" role="menu" hidden>
                        @if (canAttach)
                        {
                            <button class="plus-item" type="button" role="menuitem" id="attach-btn" title="끌어 놓기 · 캡처 붙여 넣기도 됨, 하나 @(Attachments.MaxBytes / 1024 / 1024)MB · 한 말에 @(Attachments.MaxPerMessage)개까지">파일 첨부</button>
                        }
                        @if (Model.CanModeRequest)
                        {
                            <button class="plus-item" type="button" role="menuitem" id="mode-btn" title="모드 · 에이전트 · 추론 강도를 골라 지휘자에게 외부 에이전트 요청을 보냅니다">외부 에이전트 요청</button>
                        }
                    </div>
                </div>
                @if (canAttach)
                {
                    <input type="file" id="attach-input" multiple hidden />
                }
            }
            <textarea id="text" name="text" placeholder="지휘자에게 말하기 (Enter 보내기 · Shift+Enter 줄바꿈)" maxlength="@RoomHub.MaxPromptChars"></textarea>
            <button class="btn primary" type="submit" id="send">@Icons.Svg("send") 보내기</button>
            <button class="btn" type="button" id="interrupt" disabled title="지금 턴을 멈추고 이 말을 바로 보냅니다 (기다리는 말은 남음)">@Icons.Svg("interrupt") 끼어들기</button>
            <button class="btn" type="button" id="stop" disabled>@Icons.Svg("stop") 중지</button>
        </form>
        @* 단계 설명은 접어 둔다 — 좁은 폭에서 입력칸 아래를 다 차지했다 (2-2 b 실제 확인) *@
        <details class="hint"><summary>권한: @RoomRules.LevelName(room.Level)</summary>@RoomRules.Describe(room.Level)</details>
    </div>
    </div>
    @* 오른쪽 곁칸 (3차 c, Claude 앱처럼): 단계는 화면이 steps 알림으로 그리고, 나머지 탭은 열 때 · 턴이 끝날 때 ?handler=Side로 받는다 *@
    <aside class="side" id="side" hidden aria-label="곁칸">
        @* 탭 ↔ 칸은 aria-controls · aria-labelledby로 잇고, 닫기는 tablist 밖 (/self-review c216951e79 C8) *@
        <div class="side-tabs">
            <div class="side-tablist" role="tablist" aria-label="곁칸 탭">
                <button type="button" role="tab" data-tab="steps" id="side-tab-steps" aria-controls="side-sec-steps">단계</button>
                <button type="button" role="tab" data-tab="info" id="side-tab-info" aria-controls="side-sec-info">방 정보</button>
                <button type="button" role="tab" data-tab="runs" id="side-tab-runs" aria-controls="side-sec-runs">외부 실행</button>
                <button type="button" role="tab" data-tab="files" id="side-tab-files" aria-controls="side-sec-files">첨부</button>
                <button type="button" role="tab" data-tab="docs" id="side-tab-docs" aria-controls="side-sec-docs">문서</button>
                <button type="button" role="tab" data-tab="mcp" id="side-tab-mcp" aria-controls="side-sec-mcp">연결</button>
                <button type="button" role="tab" data-tab="term" id="side-tab-term" aria-controls="side-sec-term">터미널</button>
                @if (room.Level == PermissionLevel.Command)
                {
                    <button type="button" role="tab" data-tab="browser" id="side-tab-browser" aria-controls="side-sec-browser">브라우저</button>
                }
            </div>
            <button type="button" class="side-x icon-btn" title="곁칸 닫기 (Esc)" aria-label="곁칸 닫기">@Icons.Svg("x")</button>
        </div>
        <section class="side-sec" data-tab="steps" id="side-sec-steps" role="tabpanel" aria-labelledby="side-tab-steps">
            <p class="muted" id="side-steps-empty">지휘자가 할 일 도구로 단계를 만들면 여기에 보입니다.</p>
            <ol class="side-steps" id="side-steps"></ol>
        </section>
        @* 터미널: 내 셸("+" PowerShell · ▾ 고르기, 입력 받음)과 지휘자 프로세스(명령 방, 읽기 전용).
           화면이 terminals · term-out 알림으로 그리고, 탭을 열 때 xterm.js를 불러온다 *@
        <section class="side-sec side-term" data-tab="term" id="side-sec-term" role="tabpanel" aria-labelledby="side-tab-term" hidden>
            <div class="term-top">
                <div class="term-tabs" id="term-tabs" role="tablist" aria-label="터미널"></div>
                <div class="term-new">
                    <button type="button" class="btn" id="term-new" title="새 PowerShell (작업 폴더에서)">+</button><button type="button" class="btn" id="term-new-menu" title="셸 고르기" aria-haspopup="menu" aria-expanded="false">▾</button>
                    <div class="term-menu" id="term-menu" role="menu" hidden>
                        @foreach (var (key, label) in Terminals.Shells)
                        {
                            <button type="button" role="menuitem" data-shell="@key">@label</button>
                        }
                    </div>
                </div>
            </div>
            <p class="muted" id="term-empty">+ 로 작업 폴더에서 PowerShell을 엽니다 (▾로 명령 프롬프트).@(room.Level == PermissionLevel.Command ? " 지휘자가 서버를 띄우면 '지휘자' 탭으로 보입니다 (읽기 전용)." : "")</p>
            <div class="term-bar" id="term-bar" hidden><span class="term-state" id="term-state"></span><button type="button" class="btn" id="term-stop">중지</button><button type="button" class="btn" id="term-close">닫기</button></div>
            <div class="term-host" id="term-host"></div>
        </section>
        @* 문서: 작업 폴더의 계획서 · 작업 로그 (읽기 전용). 턴 끝의 #side-data 다시 받기와 따로 — 읽는 중인 본문이 닫히지 않게.
           목록은 탭을 열 때 ?handler=Docs, 본문은 ?handler=Doc *@
        <section class="side-sec side-docs" data-tab="docs" id="side-sec-docs" role="tabpanel" aria-labelledby="side-tab-docs" hidden>
            <div id="docs-list"><p class="muted">불러오는 중…</p></div>
            <div id="docs-view" hidden>
                <div class="docs-bar"><button type="button" class="btn" id="docs-back">← 목록</button> <span class="muted" id="docs-path"></span></div>
                <div class="docs-body body" id="docs-body"></div>
            </div>
        </section>
        @* 지휘자 브라우저 (결정 "보기만"): 명령 방만. browser · browser-frame 알림으로 그린다 *@
        @if (room.Level == PermissionLevel.Command)
        {
            <section class="side-sec side-browser" data-tab="browser" id="side-sec-browser" role="tabpanel" aria-labelledby="side-tab-browser" hidden>
