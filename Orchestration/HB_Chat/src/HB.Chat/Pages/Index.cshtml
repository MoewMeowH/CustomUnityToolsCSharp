@page
@model IndexModel
@{
    ViewData["Title"] = "HB Chat";
}
@* 두 칸 화면의 첫 화면: 왼쪽 방 목록 + 오른쪽 새 방 만들기. 좁은 폭에서는 목록만 보이고 "+ 새 방"이 이 칸을 연다. *@
<div class="app@(Model.Error is not null || Model.ShowTrash || Model.Sidebar.Rooms.Count == 0 || Request.Query.ContainsKey("new") ? " in-room" : "")">
    <partial name="_Sidebar" model="Model.Sidebar" />
    <section class="pane" id="pane">
        <div class="welcome">
            <p class="mobile-only" style="margin:0 0 8px"><a class="back" href="/">@Icons.Svg("back") 방 목록</a></p>
            @if (Model.LoadError is not null)
            {
                <div class="panel" style="padding:10px 14px;border-color:var(--err);margin-bottom:12px">방 색인을 읽지 못했습니다 (덮어쓰지 않음): @Model.LoadError</div>
            }
            @if (Model.Error is not null)
            {
                <div class="panel" style="padding:10px 14px;border-color:var(--warn);margin-bottom:12px">@Model.Error</div>
            }
            @if (Model.ShowTrash)
            {
                @* 휴지통: 30일이 지나면 방 목록에서 지운다 — 세션 기록은 남는다 (사용자 결정) *@
                <section class="panel" style="padding:12px 14px;margin-bottom:16px">
                    <h2 style="margin:0 0 6px;font-size:16px">휴지통</h2>
                    <p class="muted" style="margin:0 0 10px;font-size:12.5px">넣은 지 30일이 지나면 방 목록 · 첨부를 지웁니다. 세션 기록(대시보드에서 보이는 대화)은 남습니다.</p>
                    @if (Model.TrashRooms.Count == 0)
                    {
                        <p class="muted" style="margin:0">비어 있습니다.</p>
                    }
                    else
                    {
                        @* 즉시 비우기 (4차 C1) — 되돌릴 수 없어 확인을 받는다 *@
                        <form method="post" asp-page-handler="DeleteTrash" style="margin:0 0 10px"
                              onsubmit="return confirm('휴지통의 방 @(Model.TrashRooms.Count)개를 지금 지울까요? 방 목록 · 첨부가 지워지고 되돌릴 수 없습니다 (세션 기록은 남습니다).')">
                            @* 확인 창에 보인 방들만 (그사이 다른 탭이 넣은 방은 지우지 않음 — bd52c6f0d1 C3) *@
                            @foreach (var r in Model.TrashRooms)
                            {
                                <input type="hidden" name="ids" value="@r.Id" />
                            }
                            <button class="btn" type="submit">@Icons.Svg("trash") 휴지통 비우기 (@Model.TrashRooms.Count)</button>
                        </form>
                    }
                    @foreach (var r in Model.TrashRooms)
                    {
                        <form method="post" asp-page-handler="Restore" class="trash-row">
                            <input type="hidden" name="id" value="@r.Id" />
                            <a href="/Room/@r.Id">@Model.TitleOf(r)</a>
                            <span class="muted">@r.DeletedAt?.ToLocalTime().ToString("MM-dd HH:mm") · @Trash.DaysLeft(r, DateTimeOffset.Now)일 남음</span>
                            <button class="btn" type="submit">@Icons.Svg("restore") 되살리기</button>
                            <button class="btn" type="submit" asp-page-handler="DeleteTrash"
                                    onclick="return confirm('이 방을 지금 지울까요? 방 목록 · 첨부가 지워지고 되돌릴 수 없습니다 (세션 기록은 남습니다).')">@Icons.Svg("trash") 지금 지우기</button>
                        </form>
                    }
                </section>
            }
            <section class="panel" style="padding:12px 14px">
                <h2 style="margin:0 0 10px;font-size:16px">새 방</h2>
                <form method="post" asp-page-handler="Create" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                    <label>작업 폴더
                        <select name="workspace">
                            @* 설정 파일 것 + 설정 화면에서 더한 것 (3차 d) *@
                            @foreach (var w in Model.Options.AllWorkspaces)
                            {
                                <option value="@w.Name" title="@w.Path">@w.Name</option>
                            }
                        </select>
                    </label>
                    <label>권한
                        <select name="level">
                            <option value="Chat">대화</option>
                            <option value="Read" selected>읽기</option>
                            <option value="Edit">편집</option>
                            <option value="Command">명령 (승인)</option>
                        </select>
                    </label>
                    <label>모델
                        <select name="model">
                            @foreach (var m in Model.Options.ModelList)
                            {
                                <option value="@m" selected="@(m == Model.Options.DefaultModel)">@m</option>
                            }
                        </select>
                    </label>
                    @* 추론 강도 (Claude 앱 기능 B) — 곁칸 방 정보에서 나중에 바꿀 수 있다 *@
                    <label>추론 강도
                        <select name="effort">
                            <option value="" selected>@RoomEffort.Name(null)</option>
                            @foreach (var e in RoomEffort.Levels)
                            {
                                <option value="@e">@RoomEffort.Name(e)</option>
                            }
                        </select>
                    </label>
                    <input type="text" name="title" placeholder="제목 (비우면 첫 말)" maxlength="200" style="flex:1;min-width:160px" />
                    <button class="btn primary" type="submit">@Icons.Svg("plus") 만들기</button>
                </form>
                <p class="muted" style="margin:6px 0 0;font-size:12.5px">작업 폴더는 <a href="/Settings">설정</a>에서 더할 수 있습니다.</p>
                <p class="muted" style="margin:8px 0 0;font-size:12.5px">
                    대화: @RoomRules.Describe(PermissionLevel.Chat).<br />
                    읽기: @RoomRules.Describe(PermissionLevel.Read).<br />
                    편집: @RoomRules.Describe(PermissionLevel.Edit).<br />
                    명령: @RoomRules.Describe(PermissionLevel.Command).<br />
                    방의 세션은 이 앱 전용입니다 — Claude 앱 · CLI에서 이어 쓰지 마세요.
                </p>
            </section>
            @* 새 단톡방: 구성원 2~4명 · 구성원마다 단계(⑤) · 기본 MCP는 고름(기본 끔) *@
            <section class="panel" style="padding:12px 14px;margin-top:12px">
                <h2 style="margin:0 0 10px;font-size:16px">새 단톡방</h2>
                <form method="post" asp-page-handler="CreateGroup" class="group-create">
                    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                        <label title="방 목록 묶음 · 구성원 작업 폴더 칸의 기본값">단톡방 작업 폴더
                            <select name="workspace">
                                @foreach (var w in Model.Options.AllWorkspaces)
                                {
                                    <option value="@w.Name" title="@w.Path">@w.Name</option>
                                }
                            </select>
                        </label>
                        <label title="Claude 구성원이 작업 폴더 .mcp.json의 @(Model.Options.McpServer) (run_mode로 외부 에이전트 부르기)를 쓰게 — 켜면 .mcp.json에 그 항목이 있어야 합니다">
                            <input type="checkbox" name="baseMcp" value="true" /> 구성원 기본 MCP (@Model.Options.McpServer)
                        </label>
                        <label>모델
                            <select name="model">
                                @foreach (var m in Model.Options.ModelList)
                                {
                                    <option value="@m" selected="@(m == Model.Options.DefaultModel)">@m</option>
                                }
                            </select>
                        </label>
                        <input type="text" name="title" placeholder="단톡방 이름" maxlength="200" required style="flex:1;min-width:160px" />
                    </div>
                    @* 구성원 칸 (단톡방 ③ — 2~4명): 앞 두 칸은 필수, 뒤 칸은 이름을 비우면 빠진다. 칸마다 모든 입력을 보내 배열 순서가 맞는다 *@
                    @for (var i = 0; i < GroupChat.MaxMembers; i++)
                    {
                        var optional = i >= GroupChat.MinMembers;
                        <div class="group-member-row" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px">
                            <input type="text" name="names" placeholder="@(optional ? "구성원 이름 (선택)" : "구성원 이름 (예: " + (i == 0 ? "A" : "B") + ")")" maxlength="20" required="@(!optional)" style="width:140px" />
                            <input type="text" name="roles" placeholder="@(i switch { 0 => "역할 (예: 내 코드의 위험을 찾는다)", 1 => "역할 (예: A의 의견에 반박한다)", _ => "역할" })" maxlength="@GroupChat.RoleMaxChars" style="flex:1;min-width:200px" />
                            @* 단계 (단톡방 ⑤ — 구성원마다): 편집 · 명령 구성원이 낀 말은 차례로 돈다. Codex는 읽기만 *@
                            <select name="levels" title="이 구성원의 권한 단계 (Codex는 읽기만)">
                                <option value="Chat">대화</option>
                                <option value="Read" selected>읽기</option>
                                <option value="Edit">편집</option>
                                <option value="Command">명령</option>
                            </select>
                            @* 엔진 (단톡방 ②): Codex는 설정에서 고른 작업 폴더에서만 · 읽기 전용 *@
                            <select name="engines" title="이 구성원이 도는 CLI">
                                <option value="claude" selected>Claude</option>
                                <option value="codex">Codex (읽기 전용)</option>
                            </select>
                            @* 작업 폴더: 비면 단톡방 작업 폴더. 구성원은 자기 작업 폴더에서 돈다 *@
                            <select name="memberWorkspaces" title="이 구성원의 작업 폴더 (비면 단톡방 작업 폴더)">
                                <option value="" selected>단톡방 작업 폴더</option>
                                @foreach (var w in Model.Options.AllWorkspaces)
                                {
                                    <option value="@w.Name" title="@w.Path">@w.Name</option>
                                }
                            </select>
                            @* Codex 모델 · 강도는 엔진이 Codex일 때만 보인다 (chat.js syncEngine) — Claude 구성원은 단톡방 모델을 쓴다 *@
                            <select name="codexModels" title="Codex 모델" hidden>
                                <option value="" selected>Codex 기본 모델</option>
                                @foreach (var cm in Model.CodexModelList)
                                {
                                    <option value="@cm.Slug">@cm.Name</option>
                                }
                            </select>
                            <select name="codexEfforts" title="Codex 추론 강도" hidden>
                                <option value="" selected>Codex 기본 강도</option>
                                @foreach (var ce in GroupChat.CodexEfforts)
                                {
                                    <option value="@ce">@ce</option>
                                }
                            </select>
                        </div>
                    }
                    <button class="btn primary" type="submit" style="margin-top:8px">@Icons.Svg("plus") 단톡방 만들기</button>
                </form>
                <p class="muted" style="margin:6px 0 0;font-size:12.5px">
                    부른 구성원만 답합니다 (@@이름 · 여러 명 · @@All은 동시에, 같은 대화를 받고). 구성원마다 세션이 따로 돌고, 단톡방 대화를 함께 받습니다.
                    편집 · 명령 구성원이 낀 말은 구성원 순서대로 하나씩 돌고, 뒤 구성원은 앞 답을 받습니다. 승인 · 질문 카드는 단톡방 화면에 구성원 이름으로 나옵니다.
                    구성원마다 작업 폴더를 고를 수 있습니다 — 구성원은 자기 작업 폴더에서 돌고, 다른 구성원 폴더의 파일은 보지 못할 수 있습니다.
                    Codex 구성원은 <a href="/Settings">설정</a>에서 고른 작업 폴더에서만 됩니다 (지금: @(Model.CodexWorkspaces.Count == 0 ? "없음" : string.Join(", ", Model.CodexWorkspaces))) — 읽기 전용이지만 디스크 전체를 읽을 수 있습니다.
                </p>
            </section>
        </div>
    </section>
</div>
