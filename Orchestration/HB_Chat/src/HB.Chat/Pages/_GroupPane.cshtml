@model RoomModel
@inject ProfileView Profiles
@*
    단톡방 칸: 머리(구성원 · 상태 · 과정 보기) + 대화 줄 말풍선 + 입력칸. 동작은 wwwroot/chat.js의 mountGroup.
    구성원 도구 상세는 그 구성원 자식 방("과정 보기"). 승인 · 질문 카드는 단톡방 화면에도 구성원 이름으로 나오고 여기서 답한다(⑤ — 답은 그 자식 방 처리기로).
*@
@{
    var room = Model.Room;
}
<div class="room group" data-room="@room.Id" data-group="1" data-title="@Model.Title">
    <div class="room-main">
    <section class="room-head">
        <a class="back" href="/" title="방 목록" aria-label="방 목록">@Icons.Svg("back")</a>
        <div class="head-title">
            <h2 id="room-title">@Model.Title</h2>
            <span class="muted">@(room.Playground is not null ? "놀이터 · 판 폴더 편집 · 웹" : "단톡방 · " + RoomRules.LevelName(room.Level)) · @room.Model · @Model.GroupWorkspaceLabel</span>
            <span class="muted group-cost" id="group-cost" title="Claude 구성원: claude가 알려 준 세션 누적 비용(구독이라 실제 청구 아님) · Codex 구성원: 과정 기록의 토큰">@Model.GroupCostLine()</span>
        </div>
        <div class="members" id="members">
            @foreach (var m in room.Members)
            {
                var state = Model.MemberState(m);
                <span class="member@(state is null ? "" : " active")" data-member="@m.Id" data-room="@m.RoomId" data-name="@m.Name" title="@(m.Role.Length > 0 ? m.Role : "역할 없음")">
                    <button type="button" class="btn member-call" data-name="@m.Name" title="입력칸에 @@@m.Name 넣기">@@@m.Name</button>
                    @if (Model.EngineLabel(m) is { } engine)
                    {
                        <span class="badge member-engine" title="읽기 전용 · 디스크 전체를 읽을 수 있음">@engine</span>
                    }
                    @if (Model.MemberWorkspace(m) is { } ws)
                    {
                        <span class="badge member-ws" title="이 구성원의 작업 폴더: @Model.WorkspaceTitle(ws)">@ws</span>
                    }
                    @if (Model.WriterLabel(m) is { } writer)
                    {
                        <span class="badge member-level" title="작업 폴더에 쓰는 구성원 — 이 구성원이 낀 말은 차례로 돕니다">@writer</span>
                    }
                    <span class="member-state muted">@state</span>
                    <a href="/Room/@m.RoomId" target="_blank" class="icon-link" title="@(m.Name)의 과정 (도구 · 승인 · 질문 카드)" aria-label="@(m.Name) 과정 보기">@Icons.Svg("external")</a>
                </span>
            }
        </div>
        @* 구성원 아바타 — 화면이 답 쓰는 중 임시 말풍선을 만들 때 복사한다 (그림은 서버가 그린다) *@
        @foreach (var m in room.Members)
        {
            <template class="member-avatar" data-member="@m.Id">@Profiles.Avatar(ProfileStore.AgentKey(m.Name), m.Name)</template>
        }
        <span class="u-push-right muted" id="conn"></span>
        <button type="button" class="btn icon-only" data-house="@room.Id" title="놀이방 — 구성원 작업을 집 안 캐릭터로 보는 따로 창" aria-label="놀이방 열기">@Icons.Svg("house")</button>
        <details class="menu">
            <summary class="btn icon-only" title="방 메뉴" aria-label="방 메뉴">@Icons.Svg("more")</summary>
            <div class="menu-items">
                @if (room.DeletedAt is null)
                {
                    <button type="button" class="menu-trash">@Icons.Svg("trash") 휴지통으로</button>
                }
            </div>
        </details>
    </section>

    @if (room.Playground is { } pg)
    {
        @* 놀이터 줄 (chat.js mountGroup syncPlayground가 대화 줄을 받을 때 다시 받는다) *@
        <div class="panel playground-bar" id="playground" data-state="@pg.State" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:6px 10px;padding:6px 10px">
            <span id="playground-line">@Model.PlaygroundLine()</span>
            <span class="muted" style="font-size:12.5px" title="판 폴더 — 구성원이 만든 파일. 웹 검색 결과에 영향받았을 수 있으니 열거나 실행하기 전에 내용을 확인하세요">@pg.Folder</span>
            <span class="u-push-right"></span>
            <button type="button" class="btn primary" data-pg-action="start" data-pg-show="Waiting Paused">@Icons.Svg("send") <span data-pg-start>@(pg.State == PlaygroundState.Paused ? "계속" : "시작")</span></button>
            <button type="button" class="btn" data-pg-action="pause" data-pg-show="Running">일시 정지</button>
            <button type="button" class="btn" data-pg-action="stop" data-pg-show="Running Paused">@Icons.Svg("stop") 멈춤</button>
        </div>
    }
    <div class="scroll">
        @if (room.DeletedAt is not null)
        {
            <div class="panel banner" id="trash-banner">
                휴지통에 있는 단톡방입니다 — @Trash.DaysLeft(room, DateTimeOffset.Now)일 뒤 완전히 지웁니다. 말을 보내려면 되살리세요.
                <button type="button" class="btn menu-restore">@Icons.Svg("restore") 되살리기</button>
            </div>
        }
        <partial name="_GroupMessages" model="Model" />
        <div id="live"></div>
    </div>

    <div class="composer">
        <form id="send-form" autocomplete="off">
            @Html.AntiForgeryToken()
            <textarea id="text" name="text" placeholder="@(room.Playground is not null ? "끼어들기 — 다음 차례 구성원이 같이 봅니다 (@이름이면 그 구성원이 다음 차례)"
                : "@이름 · @All로 구성원 부르기 (Enter 보내기 · Shift+Enter 줄바꿈) — " + (room.Members.Any(m => Model.WriterLabel(m) is not null) ? "명령 구성원이 낀 말은 차례로" : "여러 명은 동시에"))" maxlength="@RoomHub.MaxPromptChars"></textarea>
            <button class="btn primary" type="submit" id="send">@Icons.Svg("send") 보내기</button>
            <button class="btn" type="button" id="stop" disabled="@(!room.Members.Any(Model.AnyMemberBusy))">@Icons.Svg("stop") 중지</button>
        </form>
        @if (room.Playground is not null)
        {
            <details class="hint"><summary>놀이터: 판 폴더 편집 · 웹</summary>
                시작하면 구성원이 한 명씩 차례로 말합니다 — 다음 차례는 사람이 @@이름으로 고른 구성원, 아니면 답에서 @@부른 구성원, 아니면 순서대로입니다.
                여기 쓴 말(끼어들기)은 다음 차례 구성원이 같이 봅니다. 중지 단추는 일시 정지, 멈춤은 판을 끝냅니다.
                Claude 구성원은 판 폴더 안 파일 읽기 · 만들기 · 고치기와 웹 검색 · 웹 페이지 읽기(카드 없이 — 로컬 · 사설망 주소는 안 됨, 승인 기록에 남음)를 하고, 찾은 것은 링크 · 요약으로 대화에 공유합니다. 명령 실행 · 질문 카드는 없고, 판 폴더 밖 쓰기는 카드 없이 거절됩니다.
                말 수 · 시간 · 추정 비용 상한에 닿으면 첫 구성원이 마무리 요약을 한 번 하고 끝납니다 (시간 · 비용은 답이 끝난 뒤 봐서 답 하나만큼 넘을 수 있습니다).
            </details>
        }
        else
        {
            <details class="hint"><summary>단톡방: @RoomRules.LevelName(room.Level)</summary>
                부른 구성원만 답합니다. 구성원은 마지막으로 본 뒤의 단톡방 대화를 함께 받습니다. 명령 구성원이 낀 말은 구성원 순서대로 하나씩 돌고, 뒤 구성원은 앞 답을 받습니다.
                구성원의 승인 · 질문 카드는 이 화면에 구성원 이름으로 나옵니다.
                @RoomRules.Describe(room.Level, AppOptions.Value.AskAppWrites)
            </details>
        }
    </div>
    </div>
</div>
