@model IReadOnlyList<SearchHit>
@*
    검색 결과 (계획서 2-2 c). 누르면 그 방을 열고(chat.js) 그 말이 보일 때까지 앞 쪽을 받아 강조한다. 글 조각은 Razor 인코딩.
*@
<div class="search-list">
    @foreach (var h in Model)
    {
        <a class="search-hit" href="/Room/@h.RoomId" data-room="@h.RoomId" data-line="@(h.Line?.ToString() ?? "")">
            <div class="row">
                <span class="name">@h.Title</span>
                <span class="time">@h.At?.ToLocalTime().ToString("MM-dd HH:mm")</span>
            </div>
            <div class="snippet">
                @if (h.Line is null)
                {
                    <span class="badge">방 이름</span>
                }
                else
                {
                    <b>@(h.Speaker == ChatSpeaker.User ? "나" : h.Speaker == ChatSpeaker.Conductor ? "지휘자" : "안내"):</b>
                }
                @h.Snippet
            </div>
        </a>
    }
    @if (Model.Count == 0)
    {
        <p class="muted" style="padding:12px">찾은 것이 없습니다.</p>
    }
    else if (Model.Count >= RoomList.SearchMax)
    {
        <p class="muted" style="padding:8px 12px;font-size:12px">최근 @(RoomList.SearchMax)개만 보입니다 — 검색어를 더 좁혀 보세요.</p>
    }
</div>
