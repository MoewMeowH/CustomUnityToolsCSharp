@model RoomModel
@inject ProfileView Profiles
@*
    말풍선 한 쪽 (세션 기록의 사용자 · 지휘자 글, 계획서 2-2 b). 첫 화면 · 방 전환 · ?handler=Messages가 같이 쓴다.
    data-first-line: 이 쪽 첫 말의 줄 번호 (위로 불러오기의 before), data-has-more: 그 앞에 더 있는지,
    data-last-line: 세션 기록 마지막 말 줄 번호 (새 말 받기의 after · 읽음 표시). 말풍선 data-line은 같은 줄 번호.
    Fragment(before · after 응답)면 빈 방 안내 · 읽기 실패 줄을 그리지 않는다 — 화면이 안의 말풍선만 옮겨 붙인다.
*@
@{
    var items = Model.Messages.Items;

    // 외부 에이전트 · API 리뷰 말풍선 (계획서 2-2 e): 이 방에서 부른 run_mode 실행의 시작 줄과 단계 응답. 시각으로 끼운 자리에 (RoomRuns).
    // 답장 · data-line은 달지 않는다 (지휘자 · 사용자 말이 아니고, 줄 번호는 다음 말 것이라 쪽 경계를 흐린다).
    // trailing: 마지막 말 뒤 말풍선 — run-trailing 클래스를 달아 새 말 받기 조각이 바꿔 끼운다 (/self-review a9e6066519 C1).
    void RunBubbleList(IReadOnlyList<RunBubble> bubbles, bool trailing = false)
    {
        foreach (var b in bubbles)
        {
            var link = Model.CallLink(b);
            if (b.Kind == RunBubbleKind.Start)
            {
                <div class="system run-start@(trailing ? " run-trailing" : "")">
                    <span class="body">@Model.RenderRun(b)</span>
                    <span class="when">@b.At.ToLocalTime().ToString("HH:mm") · @b.Detail</span>
                    @if (link is not null)
                    {
                        <a href="@link" target="_blank" rel="noopener">호출 상세</a>
                    }
                </div>
                continue;
            }
            <div class="msg @RoomModel.RunClass(b)@(b.IsError ? " error" : "")@(trailing ? " run-trailing" : "")">
                @* 외부 에이전트 프로필 (3차 e): 이름별 보이는 이름 · 그림 · 색. 원래 이름은 title로 *@
                @{ var agentName = Profiles.AgentName(b.Name); }
                @Profiles.Avatar(ProfileStore.AgentKey(b.Name), agentName, b.Name)
                <div class="bubble">
                    <div class="who">
                        <b title="@b.Name">@agentName</b>
                        <span class="detail">@b.Detail</span>
                        <span class="when">@b.At.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                        @if (link is not null)
                        {
                            <a href="@link" target="_blank" rel="noopener">호출 상세</a>
                        }
                    </div>
                    @if (b.Markdown.Length > RoomModel.RunFoldChars)
                    {
                        <details class="long"><summary>응답 펼치기 (@b.Markdown.Length.ToString("N0")자)</summary><div class="body">@Model.RenderRun(b)</div></details>
                    }
                    else
                    {
                        <div class="body">@Model.RenderRun(b)</div>
                    }
                    @Model.RunSticker(b)
                </div>
            </div>
        }
    }
}
@* data-error: 세션 기록을 읽지 못한 채 그린 쪽 — 화면은 다음 새 말 받기 대신 쪽 전체를 다시 받는다 (/self-review 83b453653b C6) *@
<div class="chat" id="chat" data-title="@Model.Title" data-last-line="@Model.LastLine"
     data-first-line="@(items.Count > 0 ? items[0].Line : -1)" data-has-more="@(Model.Messages.HasMore ? "1" : "0")"
     data-error="@(Model.Transcript?.FormatError is null ? null : "1")" data-reset="@(Model.Messages.Reset ? "1" : null)">
    @if (!Model.Fragment && Model.Transcript?.FormatError is { } formatError)
    {
        <div class="panel" style="padding:10px 14px;border-color:var(--warn)">세션 기록을 읽지 못했습니다: @formatError</div>
    }
    @if (!Model.Fragment && Model.Messages.HasMore)
    {
        @* 눌러도 불러온다 — 맨 위에서 실패하면 스크롤 이벤트가 다시 안 나므로 (83b453653b C8) *@
        <button type="button" class="older muted">앞 말 @(RoomList.PageSize)개 더 보기 (위로 올려도 됨)</button>
    }
    @foreach (var e in items)
    {
        if (e.ToolsBefore > 0)
        {
            <div class="tools" data-line="@e.Line">
                @if (e.Tools.Count > 0)
                {
                    foreach (var (name, count) in RoomList.ToolChips(e.Tools))
                    {
                        <span class="chip">@(count > 1 ? $"{name} ×{count}" : name)</span>
                    }
                }
                else
                {
                    <span class="chip">도구 @(e.ToolsBefore)개</span>
                }
            </div>
        }
        RunBubbleList(Model.Runs.For(e));
        if (RoomModel.IsStoppedTurn(e))
        {
            <div class="system" data-line="@e.Line"><span class="body">중지된 턴</span> <span class="when">@e.Timestamp?.ToLocalTime().ToString("HH:mm")</span></div>
            continue;
        }
        if (e.Speaker == ChatSpeaker.System)
        {
            <div class="system" data-line="@e.Line"><span class="body">@Model.Render(e)</span> <span class="when">@e.Timestamp?.ToLocalTime().ToString("HH:mm")</span></div>
            continue;
        }
        // 나 · 지휘자 프로필 (3차 e)
        var who = e.Speaker == ChatSpeaker.User ? Profiles.UserName : Profiles.ConductorName;
        @* data-speaker: 답장 인용 머리는 보이는 이름 대신 고정 "나" · "지휘자" (프로필 이름이 지휘자에게 가는 글에 섞이지 않게) *@
        <div class="msg @RoomModel.RoleClass(e.Speaker)" data-line="@e.Line" data-speaker="@(e.Speaker == ChatSpeaker.User ? "user" : "conductor")">
            @Profiles.Avatar(e.Speaker == ChatSpeaker.User ? ProfileStore.User : ProfileStore.Conductor, who)
            <div class="bubble">
                <div class="who">
                    <b>@who</b>
                    <span class="when">@e.Timestamp?.ToLocalTime().ToString("MM-dd HH:mm:ss")</span>
                    <button class="reply" type="button" title="이 말에 답장 (인용)">답장</button>
                </div>
                <div class="body">@Model.Render(e)</div>
            </div>
        </div>
    }
    @* 마지막 말보다 늦게 끝난 실행 (지휘자가 결과 뒤에 글을 쓰기 전) — 전체 쪽과 새 말 받기 조각에. 화면은 조각을 붙이기 전에 앞서 그린 것을 지운다
       (다음 말이 생기면 그 말 앞으로 옮겨 간다). 위로 불러오기 조각에는 없다 *@
    @if (!Model.Fragment || Model.AfterFragment)
    {
        RunBubbleList(Model.Runs.Trailing, trailing: true);
    }
    @if (!Model.Fragment && items.Count == 0 && Model.Transcript?.FormatError is null)
    {
        <p class="muted empty" style="text-align:center">아직 대화가 없습니다. 아래에 첫 말을 쓰세요.</p>
    }
</div>
